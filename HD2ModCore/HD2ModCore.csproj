<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\HD2RuntimeArmorOverride\src\armor_refresh_hotkey.lua"
                      Link="RuntimeArmorRegistry\armor_refresh_hotkey.lua" />
    <EmbeddedResource Include="..\HD2RuntimeArmorOverride\src\armor_refresh_resources.lua"
                      Link="RuntimeArmorRegistry\armor_refresh_resources.lua" />
    <EmbeddedResource Include="..\HD2RuntimeArmorOverride\src\armor_refresh_component.lua"
                      Link="RuntimeArmorRegistry\armor_refresh_component.lua" />
    <EmbeddedResource Include="..\HD2RuntimeArmorOverride\src\armor_refresh_multisite.lua"
                      Link="RuntimeArmorRegistry\armor_refresh_multisite.lua" />
    <Compile Remove="artifacts\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.13" />
    <!--
      作用：把内嵌的 SQLite 原生引擎固定在 2.1.12，绕开 GHSA-2m69-gcr7-jv3q。
      背景：Microsoft.Data.Sqlite 8.0.13 传递引入 SQLitePCLRaw.bundle_e_sqlite3 2.1.6，
      其原生库 e_sqlite3.dll 里内嵌的 SQLite 实测为 3.41.2（更早的 2.1.11 是 3.49.1），
      都低于该公告要求的 3.50.2，属于已知的高危内存破坏缺陷（CVE-2025-6965）。
      2.1.12 正是上游针对这条公告发布的维护版（发布说明：把原生库升到 SQLite 3.53.3）；
      2.1.13 的原生二进制与 2.1.12 逐字节相同，故取有公开说明的 2.1.12。
      这里只换原生引擎，托管 API（Microsoft.Data.Sqlite 8.0.13 + SQLitePCLRaw 2.1.x）保持不变，
      对归档索引的读写行为没有影响。

      Pins the bundled SQLite native engine to 2.1.12 to clear GHSA-2m69-gcr7-jv3q.
      Microsoft.Data.Sqlite 8.0.13 transitively pulls SQLitePCLRaw.bundle_e_sqlite3 2.1.6, whose
      native e_sqlite3.dll embeds SQLite 3.41.2 (and 2.1.11 embeds 3.49.1) — both below the 3.50.2
      the advisory requires, i.e. CVE-2025-6965, a high-severity memory-corruption bug.
      2.1.12 is the upstream maintenance release published for exactly that advisory (its note:
      bump the native lib to SQLite 3.53.3); 2.1.13's native binaries are byte-identical to 2.1.12's,
      so the documented 2.1.12 wins. Only the native engine moves; the managed API stays put, so
      archive-index reads and writes behave exactly as before.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\HD2ModAdaptation\HD2ModAdaptation.csproj" />
	<ProjectReference Include="..\HD2GameItemAssets\HD2GameItemAssets.csproj" />
	<ProjectReference Include="..\Decryptor\Decryptor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\HD2RuntimeArmorOverride\src\armor_refresh_code_probe.lua"
                      Link="RuntimeArmorRegistry\armor_refresh_code_probe.lua" />
    <EmbeddedResource Include="..\HD2RuntimeArmorOverride\src\armor_refresh_route_probe.lua"
                      Link="RuntimeArmorRegistry\armor_refresh_route_probe.lua" />
    <EmbeddedResource Include="..\HD2RuntimeArmorOverride\src\armor_refresh_world_probe.lua"
                      Link="RuntimeArmorRegistry\armor_refresh_world_probe.lua" />
    <EmbeddedResource Include="..\HD2RuntimeArmorOverride\src\armor_refresh_probe.lua"
                      Link="RuntimeArmorRegistry\armor_refresh_probe.lua" />
    <EmbeddedResource Include="..\HD2RuntimeArmorOverride\src\armor_registry_transaction.lua"
                      Link="RuntimeArmorRegistry\armor_registry_transaction.lua" />
    <EmbeddedResource Include="..\HD2RuntimeArmorOverride\src\armor_registry_composition.lua"
                      Link="RuntimeArmorRegistry\armor_registry_composition.lua" />
    <EmbeddedResource Include="..\HD2RuntimeArmorOverride\src\armor_registry_protocol.lua"
                      Link="RuntimeArmorRegistry\armor_registry_protocol.lua" />
    <!--
      衣柜 section 掩码的只读解析器。必须和协议一样内嵌：运行时没有磁盘上的 src 目录可读，
      拼接顺序由 RuntimeArmorRegistryLuaSource 决定，这个文件排在入口点之前。
      Read-only wardrobe mask parser. Embedded for the same reason as the protocol: the runtime has no
      src directory on disk, and RuntimeArmorRegistryLuaSource controls the concatenation order.
    -->
    <EmbeddedResource Include="..\HD2RuntimeArmorOverride\src\armor_wardrobe_masks.lua"
                      Link="RuntimeArmorRegistry\armor_wardrobe_masks.lua" />
    <!--
      unit TOC 的只读结构解析：运行时据此自己算出 section 偏移，不必读构建期的映射表。
      实测依据见 notes/section-toc-memory-header-differs-only-in-unit-id-20261019.md。
      Read-only unit TOC walker: lets the runtime derive section offsets itself instead of
      reading a build-time map. Evidence in the note referenced above.
    -->
    <EmbeddedResource Include="..\HD2RuntimeArmorOverride\src\armor_section_layout.lua"
                      Link="RuntimeArmorRegistry\armor_section_layout.lua" />
    <!--
      把掩码翻译成 NumIndices 写入并保证可回滚。与走查器分开：这一层只做"算计划/执行"，
      所以能离线用可变字节缓冲测出恢复与回滚，不必进游戏。
      Turns masks into NumIndices writes with rollback. Kept apart from the walker so the
      restore and rollback paths can be verified offline against a mutable byte buffer.
    -->
    <EmbeddedResource Include="..\HD2RuntimeArmorOverride\src\armor_section_apply.lua"
                      Link="RuntimeArmorRegistry\armor_section_apply.lua" />
    <!--
      在进程内存里按 FileId+8 个零字节定位 unit 的 TOC 副本，命中后用结构走查验证。
      与走查器分开是为了能用"假内存"离线测误命中、坏副本、缓存失效。
      Locates a unit's TOC copy by its FileId and validates it structurally; kept apart so
      false hits, broken copies and cache invalidation can be exercised against fake memory.
    -->
    <EmbeddedResource Include="..\HD2RuntimeArmorOverride\src\armor_section_locate.lua"
                      Link="RuntimeArmorRegistry\armor_section_locate.lua" />
    <EmbeddedResource Include="..\HD2RuntimeArmorOverride\src\armor_registry_runtime.lua"
                      Link="RuntimeArmorRegistry\armor_registry_runtime.lua" />
    <EmbeddedResource Include="..\HD2RuntimeArmorOverride\src\armor_metadata_probe_core.lua"
                      Link="RuntimeArmorRegistry\armor_metadata_probe_core.lua" />
    <EmbeddedResource Include="..\HD2RuntimeArmorOverride\src\armor_metadata_probe.lua"
                      Link="RuntimeArmorRegistry\armor_metadata_probe.lua" />
  </ItemGroup>

  <ItemGroup>
    <!--
      作用：把管理器资源目录里的资产类型哈希表（typehash.txt）内嵌进 Core，供 AssetTypeNameTable 解析
      "unit / state_machine / cloth" 这类可读类型名。刻意引用管理器资源目录里的那一份，而不是另存一份：
      类型哈希表只有一份真相，更新路径仍然是 assets metadata plan/apply 写 StoragePaths.TypeHashesPath，
      内嵌副本只是"没有管理器安装时"的默认值，且只影响显示名，不影响提取结果的正确性。
      Purpose: Embeds the manager resource directory's asset type hash table so AssetTypeNameTable can resolve
      readable type names. It deliberately references the single existing copy instead of duplicating it: the
      table keeps one source of truth (updated by assets metadata plan/apply into StoragePaths.TypeHashesPath),
      and the embedded copy is only the default for machines with no manager install. A stale copy affects
      display names only, never the correctness of an extraction.
    -->
    <EmbeddedResource Include="..\HD2ModManager\Resources\AssetMetadata\typehash.txt"
                      Link="AssetMetadata\typehash.txt" />
  </ItemGroup>

</Project>
