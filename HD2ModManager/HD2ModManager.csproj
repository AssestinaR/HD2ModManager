<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="artifacts\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HD2ModCore\HD2ModCore.csproj" />
    <!-- Build the headless companion with the desktop application, without
         making the WPF application depend on the CLI assembly at runtime. -->
    <ProjectReference Include="..\HD2ModCli\HD2ModCli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\helldivers2.ico" />
    <Resource Include="Resources\helldivers2.png" />
    <!-- Ship one consistent, versioned metadata snapshot so first launch and
         GameData indexing do not depend on GitHub being reachable. Online
         metadata maintenance can still safely replace these files later. -->
    <Content Include="Resources\AssetMetadata\**\*" Link="data\resources\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="ThirdParty\7zip\**\*" Link="third_party\7zip\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest">
      <!-- 7z.exe is launched as a real child process, so it must remain a
           physical file beside the published application. -->
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
  
  <!-- Rely on implicit ApplicationDefinition for App.xaml -->

  <!-- Rely on implicit WPF XAML items; do not explicitly include Page/ApplicationDefinition to avoid duplicates -->

  <!-- Use implicit EmbeddedResource items for .resx files; remove explicit includes to avoid duplicates -->

  <!-- Keep CLI entry artifacts beside development builds. The release script
       intentionally relocates the published CLI into bin and validates it
       against the matching release layout. -->
  <Target Name="CopyHd2ModCliArtifacts" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\HD2ModCli\HD2ModCli.csproj"
             Targets="GetHd2ModCliArtifactFiles"
             Properties="Configuration=$(Configuration);Platform=$(Platform);BaseOutputPath=$(BaseOutputPath)">
      <Output TaskParameter="TargetOutputs" ItemName="Hd2ModCliArtifact" />
    </MSBuild>
    <Copy SourceFiles="@(Hd2ModCliArtifact)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Hd2ModCliDocumentation Include="$(MSBuildProjectDirectory)\..\HD2ModCli\README.md" />
      <Hd2ModCliDocumentation Include="$(MSBuildProjectDirectory)\..\HD2ModCli\SKILL.md" />
	  <Hd2ModCliSkillDocumentation Include="$(MSBuildProjectDirectory)\..\HD2ModCli\skills\**\SKILL.md" />
    </ItemGroup>
    <Copy SourceFiles="@(Hd2ModCliDocumentation)"
          DestinationFiles="@(Hd2ModCliDocumentation->'$(TargetDir)hd2mod-docs\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
	<Copy SourceFiles="@(Hd2ModCliSkillDocumentation)"
		  DestinationFiles="@(Hd2ModCliSkillDocumentation->'$(TargetDir)hd2mod-docs\skills\%(RecursiveDir)%(Filename)%(Extension)')"
		  SkipUnchangedFiles="true" />
  </Target>

</Project>
