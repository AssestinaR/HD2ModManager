<UserControl x:Class="HD2ModManager.Controls.Search.SearchTagBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <!--
        标签式搜索框：一枚方角标签 + 一个无边框输入框，同住 32 高的一个框里。

        - 左侧是标签区（横向滚动、无滚动条），右侧是输入区（保底 96，永远不会被标签挤没）；
        - 标签区的上限宽度在 SizeChanged 里一次算好，不做反馈式测量；
        - 点击框内空白处 = 把焦点交给输入框（不用精确点中那条细长的输入区）。
    -->
    <Border x:Name="Chrome"
            Height="32"
            CornerRadius="6"
            Background="{StaticResource SurfaceCard}"
            BorderThickness="1"
            PreviewMouseLeftButtonDown="OnChromeMouseDown">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource StrokeControl}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=InputBox}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource StrokeFocus}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="TagScroller"
                          Grid.Column="0"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          Focusable="False"
                          VerticalAlignment="Center"
                          Padding="4,0,0,0"
                          PreviewMouseWheel="OnTagScrollerMouseWheel">
                <ItemsControl x:Name="TagItems" Focusable="False"
                              ItemsSource="{Binding Tags, ElementName=Root}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding}"
                                    Margin="0,0,3,0"
                                    ToolTip="{Binding ToolTip}"
                                    Click="OnTagClick">
                                <Button.Style>
                                    <!-- 底色在共享样式之上按种类追加：分类用浅蓝、宿主筛选用更实的蓝、
                                         自由词保持中性灰。三种撤销含义不同，只靠颜色区分不够，分类还带图标。 -->
                                    <Style TargetType="Button" BasedOn="{StaticResource AppSearchTagChip}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Filter">
                                                <Setter Property="Background" Value="{StaticResource SurfaceSelected}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource StrokeFocus}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Category">
                                                <Setter Property="Background" Value="{StaticResource SurfaceSelected}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Width="11" Height="11"
                                          Margin="0,0,3,0"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource RowIcon.Category}"
                                          Stretch="Uniform"
                                          StrokeThickness="1.6"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="{Binding IsCategory, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                    <Path Width="7" Height="7"
                                          Margin="4,0,0,0"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource ActionIcon.Cross}"
                                          Stretch="Uniform"
                                          StrokeThickness="1.6"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBox x:Name="InputBox"
                     Grid.Column="1"
                     Style="{StaticResource AppSearchBox}"
                     Height="30"
                     MinHeight="0"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="4,0"
                     VerticalContentAlignment="Center"
                     TextChanged="OnInputTextChanged"
                     PreviewKeyDown="OnInputPreviewKeyDown"/>
        </Grid>
    </Border>
</UserControl>
