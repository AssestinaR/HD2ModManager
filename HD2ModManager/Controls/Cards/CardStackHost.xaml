<UserControl x:Class="HD2ModManager.Controls.Cards.CardStackHost"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cards="clr-namespace:HD2ModManager.Controls.Cards"
             xmlns:scroll="clr-namespace:HD2ModManager.Controls.Scrolling"
             Focusable="False">
    <!--
        作用：受管控的卡片栈。逻辑层只递交 CardDescriptor（Id/Kind/Title/可见性/高度范围），
        这里负责外壳、间距、增删与可见性变化的重排动画、高度动画、以及"缺模板"兜底。

        它不认识任何业务类型：内容通过 Kind → Themes/CardTemplates.xaml 的模板解析。
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <cards:CardHeightConverter x:Key="CardHeight"/>
        <cards:CardOverflowConverter x:Key="CardOverflow"/>

        <Style x:Key="CardShell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
            <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Role}" Value="Elevated">
                    <Setter Property="Effect" Value="{StaticResource ElevatedPanelShadow}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="Notice">
                    <Setter Property="Background" Value="{StaticResource SurfaceMuted}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="Danger">
                    <Setter Property="BorderBrush" Value="{StaticResource StatusDanger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="Interactive">
                    <Setter Property="Cursor" Value="Hand"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Margin" Value="{StaticResource CardStackMargin}"/>
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
            <Setter Property="Height" Value="{Binding PreferredHeight, Converter={StaticResource CardHeight}}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ItemsControl x:Name="ItemsHost"
                      Focusable="False"
                      ItemContainerStyle="{StaticResource CardContainerStyle}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Shell" Style="{StaticResource CardShell}"
                            MinHeight="{Binding MinHeight}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!--
                                    第二行用 *：容器高度固定时它吃掉剩余空间并让内容滚动；
                                    容器高度自适应时（测量高度为无穷）* 退化为内容高度。
                                -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid x:Name="Header" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <ContentPresenter Grid.Column="1"
                                                  Content="{Binding HeaderContent}"
                                                  VerticalAlignment="Center"
                                                  Margin="12,0,0,0"/>
                            </Grid>

                            <ScrollViewer x:Name="BodyScroll"
                                          Grid.Row="1"
                                          scroll:WheelScroll.IsEnabled="True"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="{Binding Overflow, Converter={StaticResource CardOverflow}}"
                                          MaxHeight="{Binding MaxHeight}">
                                <cards:CardBodyPresenter x:Name="Body"
                                                         Content="{Binding Data}"
                                                         Kind="{Binding Kind}"/>
                            </ScrollViewer>

                            <TextBlock x:Name="MissingTemplate"
                                       Grid.Row="1"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{StaticResource StatusDanger}"
                                       Text="{Binding Kind, StringFormat=缺少卡片模板：Themes/CardTemplates.xaml 或页面资源里的 CardTemplate.{0}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTemplate, ElementName=Body}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <DataTemplate.Triggers>
                        <!-- 没有标题也没有右侧动作时，整行不占高度。 -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Title}" Value="{x:Null}"/>
                                <Condition Binding="{Binding HeaderContent}" Value="{x:Null}"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 移除动画用的幽灵层：放一个旧尺寸的副本在原地淡出。 -->
        <Canvas x:Name="TransitionOverlay" IsHitTestVisible="False" ClipToBounds="False"/>
    </Grid>
</UserControl>
