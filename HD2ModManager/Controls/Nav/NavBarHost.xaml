<UserControl x:Class="HD2ModManager.Controls.Nav.NavBarHost"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nav="clr-namespace:HD2ModManager.Controls.Nav"
             Focusable="False">
    <!--
        作用：声明的顶栏。逻辑层只递交 NavItemDescriptor（文案/图标枚举/顺序/可见性/激活/角标），
        这里负责按钮外观、激活指示块的滑动、增删与可见性变化的重排、以及窄窗口下的横向滚动。

        滚动盒刻意不显示滚动条：两侧用渐隐遮罩提示"还有内容"，而不是画一条横条。
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <nav:NavItemTemplateSelector x:Key="NavItemTemplate"/>
        <nav:NavIconGeometryConverter x:Key="NavIconGeometry"/>

        <Style x:Key="NavItemButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            激活态不再靠 Foreground 瞬时切换，而是"两层文字交叉淡入"：
            底层用未激活配色（跟随按钮 Foreground），上层固定白色叠在上面。
            指示块滑走时下层露出来、滑到时上层盖上去，颜色过渡跟着指示块一起走。
        -->
        <DataTemplate x:Key="NavItem.Primary">
            <Button Style="{StaticResource NavItemButton}"
                    Command="{Binding Command}"
                    ToolTip="{Binding Label}"
                    AutomationProperties.Name="{Binding Label}"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <StackPanel x:Name="IdleLayer"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Path Width="15" Height="15" Margin="0,0,6,0"
                              Data="{Binding IconKey, Converter={StaticResource NavIconGeometry}}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"/>
                        <TextBlock Text="{Binding Label}"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>

                    <StackPanel x:Name="ActiveLayer"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Opacity="0">
                        <Path Width="15" Height="15" Margin="0,0,6,0"
                              Data="{Binding IconKey, Converter={StaticResource NavIconGeometry}}"
                              Stroke="White"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"/>
                        <TextBlock Text="{Binding Label}"
                                   VerticalAlignment="Center"
                                   Foreground="White"/>
                    </StackPanel>

                    <Border x:Name="Badge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,-2,0"
                            MinWidth="14" Height="14"
                            Padding="3,0"
                            CornerRadius="7"
                            Background="{StaticResource StatusDanger}"
                            Visibility="Collapsed">
                        <TextBlock Text="{Binding Badge}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="9"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasBadge}" Value="True">
                    <Setter TargetName="Badge" Property="Visibility" Value="Visible"/>
                </DataTrigger>

                <!--
                    时长略短于指示块的 240ms：颜色比位置早一点落定，
                    看起来是"指示块滑到位时字已经是白的"，而不是两件事各走各的。
                -->
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="IdleLayer"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.22"/>
                                <DoubleAnimation Storyboard.TargetName="ActiveLayer"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.22"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="IdleLayer"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.22"/>
                                <DoubleAnimation Storyboard.TargetName="ActiveLayer"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.22"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Viewport" ClipToBounds="True" Background="Transparent">
        <ScrollViewer x:Name="Scroller"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Focusable="False"
                      PreviewMouseWheel="OnPreviewMouseWheel"
                      ScrollChanged="OnScrollChanged">
            <!--
                ContentRoot 至少和视口一样宽，内部再把按钮条居中：
                宽窗口时居中、窄窗口时撑开并横向滚动，两种情况下激活块的坐标都以 ContentRoot 为基准。
            -->
            <Grid x:Name="ContentRoot" MinWidth="{Binding ViewportWidth, ElementName=Scroller}">
                <Canvas x:Name="IndicatorLayer" IsHitTestVisible="False">
                    <Border x:Name="ActiveIndicator"
                            Background="{StaticResource Accent}"
                            CornerRadius="16"
                            Opacity="0"/>
                </Canvas>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ItemsControl x:Name="LeadingHost"
                                  Focusable="False"
                                  ItemsSource="{Binding LeadingItems, ElementName=Root}"
                                  ItemTemplateSelector="{StaticResource NavItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ContentPresenter x:Name="CenterSlot"
                                      Content="{Binding CenterContent, ElementName=Root}"
                                      VerticalAlignment="Center"/>

                    <ItemsControl x:Name="TrailingHost"
                                  Focusable="False"
                                  ItemsSource="{Binding TrailingItems, ElementName=Root}"
                                  ItemTemplateSelector="{StaticResource NavItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Rectangle x:Name="LeftFade" Width="28" HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle x:Name="RightFade" Width="28" HorizontalAlignment="Right" IsHitTestVisible="False" Opacity="0">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                    <GradientStop Color="#FFFFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>
