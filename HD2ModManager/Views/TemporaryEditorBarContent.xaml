<UserControl x:Class="HD2ModManager.Views.TemporaryEditorBarContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding EditLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0" Visibility="{Binding HasTemporaryEditor, Converter={StaticResource BoolToVis}}"/>
        <TextBlock Text="{Binding PositionLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0" Visibility="{Binding IsPositionEditor, Converter={StaticResource BoolToVis}}"/>
        <Grid Width="220" Visibility="{Binding IsTextEditor, Converter={StaticResource BoolToVis}}">
            <TextBox Style="{StaticResource AppTextBox}"
                     Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="OnEditorTextBoxPreviewKeyDown"/>
            <TextBlock Text="{Binding PositionHint}" Foreground="{StaticResource TextTertiary}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PositionHint}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EditText}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <ComboBox Width="220" Style="{StaticResource AppCompactComboBox}" ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" Visibility="{Binding IsProfileSwitchEditor, Converter={StaticResource BoolToVis}}"/>
        <Button Style="{StaticResource AppPrimaryButton}" Content="{Binding EditConfirmText}" Command="{Binding ConfirmEditCommand}" Margin="8,0,0,0" Visibility="{Binding HasTemporaryEditor, Converter={StaticResource BoolToVis}}"/>
        <Button Style="{StaticResource AppSecondaryButton}" Content="取消" Command="{Binding CancelEditCommand}" Margin="8,0,14,0" Visibility="{Binding HasTemporaryEditor, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
</UserControl>
