<UserControl x:Class="HD2ModManager.Views.FloatingActionCluster"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:actions="clr-namespace:HD2ModManager.Controls.Actions"
             xmlns:vm="clr-namespace:HD2ModManager.ViewModels">
    <UserControl.Resources>
        <actions:PageActionIconConverter x:Key="ActionIcon"/>
        <actions:PageActionToneBrushConverter x:Key="ToneBrush"/>
        <actions:CapsuleCornerRadiusConverter x:Key="CapsuleRadius"/>

        <!--
            动作胶囊。高度由代码按"占用高度"设置（焦点项=外观高度，其余被压缩），
            而按钮本身永远是满尺寸并居中溢出——这就是"挤压=叠住"的来源。
        -->
        <Style x:Key="ClusterActionButton" TargetType="Button">
            <Setter Property="Width" Value="{Binding ButtonDiameter, ElementName=Root}"/>
            <Setter Property="Height" Value="{Binding ButtonDiameter, ElementName=Root}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Background" Value="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=Background}"/>
            <Setter Property="Foreground" Value="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=Foreground}"/>
            <Setter Property="BorderBrush" Value="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource CapsuleRadius}}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.74"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮：固定强调色（不跟随动作色调），与动作胶囊共用同一套模板。 -->
        <Style x:Key="ClusterMainButton" TargetType="Button" BasedOn="{StaticResource ClusterActionButton}">
            <Setter Property="Height" Value="{Binding ButtonDiameter, ElementName=Root}"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource ActionTone.OnAccent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Effect" Value="{StaticResource ElevatedPanelShadow}"/>
        </Style>

        <DataTemplate x:Key="ActionItemTemplate">
            <Grid x:Name="ItemRoot"
                  Width="{Binding ExpandedOuterWidth, ElementName=Root}"
                  HorizontalAlignment="Right">
                <Border x:Name="ExpandedRail"
                        MinWidth="{Binding ExpandedWidth}"
                        MaxWidth="{Binding MaxExpandedWidth, ElementName=Root}"
                        Height="{Binding ButtonDiameter, ElementName=Root}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="8,0,8,0"
                        CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource CapsuleRadius}}"
                        Background="{StaticResource SurfaceElevated}"
                        BorderBrush="{StaticResource StrokeSubtle}"
                        BorderThickness="1"
                        Effect="{StaticResource ElevatedPanelShadow}"
                        Opacity="0"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="1,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="0.6" ScaleY="0.9"/>
                    </Border.RenderTransform>
                    <Grid x:Name="RailContentHost" Margin="12,0,52,0" VerticalAlignment="Center">
                        <ContentControl x:Name="ExpandedContentHost" Content="{Binding ExpandedContent}"/>
                        <TextBlock x:Name="LabelText" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <Button x:Name="ActionButton"
                        Command="{Binding Command}"
                        CommandParameter="{Binding CommandParameter}"
                        IsEnabled="{Binding IsEnabled}"
                        ToolTip="{Binding Label}"
                        Style="{StaticResource ClusterActionButton}"
                        Click="OnActionInvoked">
                    <Path Width="16" Height="16"
                          Data="{Binding Kind, Converter={StaticResource ActionIcon}}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"/>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding LabelDirection, ElementName=Root}" Value="Right">
                    <Setter TargetName="ItemRoot" Property="HorizontalAlignment" Value="Left"/>
                    <Setter TargetName="ExpandedRail" Property="HorizontalAlignment" Value="Left"/>
                    <Setter TargetName="ExpandedRail" Property="RenderTransformOrigin" Value="0,0.5"/>
                    <Setter TargetName="RailContentHost" Property="Margin" Value="52,0,12,0"/>
                    <Setter TargetName="ActionButton" Property="HorizontalAlignment" Value="Left"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ExpandedContent}" Value="{x:Null}">
                    <Setter TargetName="LabelText" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ExpandedContentHost" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProfileSwitchActionViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="切换配置：" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                <ComboBox Style="{StaticResource AppCompactComboBox}" Width="112" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProfileRenameActionViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="重命名为：" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                <TextBox Style="{StaticResource AppTextBox}" Width="118" Text="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="ClusterRoot"
          Width="{Binding ExpandedOuterWidth, ElementName=Root}"
          Height="{Binding ClusterHeight, ElementName=Root}">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="ClusterShift" X="0" Y="0"/>
        </Grid.RenderTransform>

        <ItemsControl x:Name="ActionsHost"
                      Width="{Binding ExpandedOuterWidth, ElementName=Root}"
                      Height="{Binding ClusterHeight, ElementName=Root}"
                      ItemsSource="{Binding Actions, ElementName=Root}"
                      ItemTemplate="{StaticResource ActionItemTemplate}"
                      IsHitTestVisible="False"
                      Opacity="0"
                      VerticalAlignment="Bottom">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="0"/>
                    <Setter Property="Canvas.Bottom" Value="0"/>
                    <Setter Property="Panel.ZIndex" Value="1"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <Button x:Name="MainButton"
                HorizontalAlignment="{Binding ClusterHorizontalAlignment, ElementName=Root}"
                VerticalAlignment="Bottom"
                Panel.ZIndex="1000"
                Width="{Binding ButtonDiameter, ElementName=Root}"
                Height="{Binding ButtonDiameter, ElementName=Root}"
                ToolTip="{Binding MainToolTip, ElementName=Root}"
                Cursor="Hand"
                Style="{StaticResource ClusterMainButton}"
                PreviewMouseLeftButtonDown="OnMainButtonDragStart"
                PreviewMouseMove="OnMainButtonDragMove"
                PreviewMouseLeftButtonUp="OnMainButtonDragEnd"
                LostMouseCapture="OnMainButtonLostCapture"
                Click="OnMainButtonClick">
            <Path Width="18" Height="18"
                  Data="{StaticResource ActionIcon.Menu}"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.7"
                  StrokeStartLineCap="Round"/>
        </Button>
    </Grid>
</UserControl>
