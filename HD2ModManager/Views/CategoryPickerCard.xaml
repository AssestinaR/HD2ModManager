<UserControl x:Class="HD2ModManager.Views.CategoryPickerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 设置分类的卡片弹窗：标签式选择 + 弹窗内直接新建。由 ModListPanel 放进 Popup。 -->
    <UserControl.Resources>
        <Style x:Key="PickerPill" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceMuted}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeSubtle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="12,5" Margin="0,0,8,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- 外边距给阴影留位置（Popup 用透明窗口） -->
    <Border Margin="14" Width="300" Padding="16,14,16,8" CornerRadius="14"
            Background="{StaticResource SurfaceCard}"
            BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="1"
            Effect="{StaticResource ElevatedPanelShadow}">
        <StackPanel>
            <TextBlock Text="设置分类" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock x:Name="Subtitle" Margin="0,2,0,12" FontSize="12" Foreground="{StaticResource TextSecondary}"/>

            <ItemsControl x:Name="Pills">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource PickerPill}" Content="{Binding Display}" Click="OnPillClick"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,2,0,0">
                <StackPanel>
                    <Button x:Name="NewButton" Style="{StaticResource PickerPill}" HorizontalAlignment="Left"
                            Content="＋ 新建分类" Click="OnNewClick"/>
                    <Grid x:Name="NewPanel" Visibility="Collapsed" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewBox" Style="{StaticResource AppTextBox}" MaxLength="12"
                                 VerticalContentAlignment="Center" Padding="8,0" Height="34"
                                 PreviewKeyDown="OnNewKeyDown" TextChanged="OnNewTextChanged"/>
                        <Button Grid.Column="1" Style="{StaticResource AppPrimaryButton}" Content="创建并放入"
                                Margin="8,0,0,0" Height="34" Click="OnCreateClick"/>
                    </Grid>
                    <TextBlock x:Name="Hint" Visibility="Collapsed" Margin="2,0,0,8" FontSize="12"
                               Foreground="{StaticResource StatusDanger}" TextWrapping="Wrap"/>
                    <Button x:Name="ResetButton" Style="{StaticResource AppQuietButton}" HorizontalAlignment="Left"
                            Content="恢复自动分类" Margin="0,0,0,6" Click="OnResetClick"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
