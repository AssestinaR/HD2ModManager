<UserControl x:Class="HD2ModManager.Views.ArmorRegistryPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HD2ModManager.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="运行时护甲注册" Style="{StaticResource AppPageTitle}"/>
                <TextBlock Text="{Binding RegistryPath}" Style="{StaticResource AppSupportingText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Style="{StaticResource AppToggleSwitch}" Content="启用映射" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource AppSecondaryButton}" Content="打开目录" Command="{Binding OpenRegistryFolderCommand}" Margin="10,0,0,0"/>
                <Button Style="{StaticResource AppSecondaryButton}" Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
                <Button Style="{StaticResource AppPrimaryButton}" Content="应用" Command="{Binding ApplyCommand}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource AppInlineNotice}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource AppSupportingText}" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource AppBadge}" Margin="12,0,0,0">
                    <TextBlock Text="{Binding RevisionText}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource DataTableCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource DataTableToolbar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Style="{StaticResource AppComboBox}"
                                  ItemsSource="{Binding ArmorChoices}"
                                  SelectedItem="{Binding SelectedTarget}"
                                  DisplayMemberPath="Display"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="Display"
                                  ToolTip="目标护甲"/>
                        <TextBlock Grid.Column="1" Text="←" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                        <ComboBox Grid.Column="2"
                                  Style="{StaticResource AppComboBox}"
                                  ItemsSource="{Binding ArmorChoices}"
                                  SelectedItem="{Binding SelectedSource}"
                                  DisplayMemberPath="Display"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="Display"
                                  ToolTip="视觉来源护甲"/>
                        <Button Grid.Column="3" Style="{StaticResource AppSecondaryButton}" Content="添加映射" Command="{Binding AddMappingCommand}" Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1"
                          Style="{StaticResource DataTableGrid}"
                          ItemsSource="{Binding Mappings}"
                          IsReadOnly="True"
                          FrozenColumnCount="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="目标护甲" Binding="{Binding Target.Display}" Width="*"/>
                        <DataGridTextColumn Header="视觉来源" Binding="{Binding Source.Display}" Width="*"/>
                        <DataGridTextColumn Header="目标 Item ID" Binding="{Binding Target.ItemIdText}" Width="130"/>
                        <DataGridTemplateColumn Header="" Width="52">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource AppIconButton}"
                                            Content="×"
                                            FontSize="17"
                                            ToolTip="移除映射"
                                            Command="{Binding DataContext.RemoveMappingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
