<UserControl x:Class="HD2ModManager.Views.ArmorRegistryPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HD2ModManager.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate x:Key="ArmorPieceEditorTemplate">
            <Grid Margin="4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding SlotLabel}" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding BodyLabel}" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Unit}" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <CheckBox Grid.Column="1"
                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                          Content="启用"
                          Style="{StaticResource AppCheckBox}"
                          VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="删除" Command="{Binding RemoveCommand}"
                        Style="{StaticResource AppHeaderTextButton}"
                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                        Padding="6,1"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AvailableArmorSearchActions">
            <Button Style="{StaticResource AppHeaderTextButton}"
                    Content="{Binding AvailableArmorUnitFilterText}"
                    ToolTip="按当前活动配置中生效的 Unit 覆盖筛选；无法确认的护甲仅在“全部”中显示"
                    Click="OnCycleAvailableArmorUnitFilterClick"/>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AppInlineNotice}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource AppSupportingText}" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource AppBadge}" Margin="12,0,0,0">
                    <TextBlock Text="{Binding RevisionText}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Style="{StaticResource AppToggleSwitch}" Content="启用映射" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <Button Style="{StaticResource AppPrimaryButton}" Content="应用" Command="{Binding ApplyCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Margin="0,0,6,0">
                <local:ModListPanel x:Name="ProviderList"
                                    Grid.Row="0"
                                    ItemsSource="{Binding ProvidersView}"
                                    HeaderTitle="视觉来源"
                                    HeaderSummary="{Binding ProvidersSummary}"
                                    SearchText="{Binding ProvidersSearchText, UpdateSourceTrigger=PropertyChanged}"
                                    EmptyMessage="将右侧一个护甲拖到这里，设为视觉来源。"
                                    SelectionPolicy="Multiple"
                                    RowActions="ArmorRelease, ArmorOpenDetails, ArmorEditComponents, ArmorDeleteCustomModel, ArmorRenameCustomModel"
                                    ArmorReleaseToolTip="解除视觉对象"
                                    ArmorOpenDetailsToolTip="查看映射目标"
                                    ArmorEditComponentsToolTip="编辑视觉组件"
                                    RelationshipDragOperation="ArmorRegistryRelease"
                                    SelectionRequested="OnProviderSelectionRequested"
                                    RowRightClicked="OnProviderRightClicked"
                                    RowActionInvoked="OnProviderRowActionInvoked">
                    <local:ModListPanel.Style>
                        <Style TargetType="local:ModListPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProviderDetailOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:ModListPanel.Style>
                </local:ModListPanel>
                <Grid Grid.Row="0" Visibility="{Binding IsProviderDetailOpen, Converter={StaticResource BoolToVis}}">
                    <local:ModListPanel x:Name="ProviderDetailList"
                                        ItemsSource="{Binding ProviderDetailItemsView}"
                                        HeaderTitle="{Binding ProviderDetailHeaderTitle}"
                                        HeaderSummary="{Binding ProviderDetailSummary}"
                                        SearchText="{Binding ProviderDetailSearchText, UpdateSourceTrigger=PropertyChanged}"
                                        HeaderTitleClickable="True"
                                        EmptyMessage="此来源尚无目标；可从右侧添加护甲。"
                                        SelectionPolicy="Multiple"
                                        RowActions="ArmorRelease, ArmorEditComponents"
                                        ArmorReleaseToolTip="解除映射目标"
                                        ArmorEditComponentsToolTip="编辑目标组件"
                                        RelationshipDragOperation="ArmorRegistryRelease"
                                        SelectionRequested="OnDetailSelectionRequested"
                                        HeaderTitleClicked="OnBackToProvidersClick"
                                        RowActionInvoked="OnDetailRowActionInvoked"/>
                </Grid>
                <Grid Grid.Row="0" Background="{StaticResource SurfaceCanvas}"
                      Visibility="{Binding IsComponentEditorOpen, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource CardContainer}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0"
                                    Content="{Binding ComponentEditorTitle}"
                                    Style="{StaticResource AppHeaderTextButton}"
                                    HorizontalAlignment="Left"
                                    Click="OnCloseComponentEditorClick"
                                    ToolTip="返回视觉来源列表"/>
                            <CheckBox Grid.Row="0"
                                      Margin="0,0,8,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Content="跟随视觉来源"
                                      IsChecked="{Binding ComponentEditorFollowSource, Mode=TwoWay}"
                                      Visibility="{Binding ComponentEditorIsTarget, Converter={StaticResource BoolToVis}}"
                                      Style="{StaticResource AppCheckBox}"/>
                            <Grid Grid.Row="1" Margin="0,10,0,0"
                                  IsEnabled="{Binding ComponentEditorEditable}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8"
                                            Visibility="{Binding IsComponentEditorCustomModel, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="新增" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Style="{StaticResource AppComboBox}"
                                              ItemsSource="{Binding ComponentSlotOptions}"
                                              SelectedValue="{Binding NewComponentSlot, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Slot"
                                              MinWidth="120"
                                              Margin="0,0,8,0"/>
                                    <Button Content="确定"
                                            Command="{Binding ConfirmAddComponentRowCommand}"
                                            Style="{StaticResource AppSecondaryButton}"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ComponentEditorRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource StrokeSubtle}"
                                                    BorderThickness="0,0,0,1"
                                                    Background="{Binding RowBackground}"
                                                    Padding="0,2">
                                                <Grid MinHeight="42">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="172"/>
                                                                    <ColumnDefinition Width="1*"/>
                                                                    <ColumnDefinition Width="1*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,8,0"
                                                                            Visibility="{Binding CanEditStructure, Converter={StaticResource BoolToVis}}">
                                                                    <Button Content="{Binding StructureActionLabel}"
                                                                            Command="{Binding StructureActionCommand}"
                                                                            Style="{StaticResource AppHeaderTextButton}"
                                                                            Padding="4,1"/>
                                                                    <Button Content="新增 Stocky"
                                                                            Command="{Binding AddMissingStockyCommand}"
                                                                            Style="{StaticResource AppHeaderTextButton}"
                                                                            Padding="4,1"
                                                                            Visibility="{Binding HasMissingStocky, Converter={StaticResource BoolToVis}}"/>
                                                                    <Button Content="新增 Slim"
                                                                            Command="{Binding AddMissingSlimCommand}"
                                                                            Style="{StaticResource AppHeaderTextButton}"
                                                                            Padding="4,1"
                                                                            Visibility="{Binding HasMissingSlim, Converter={StaticResource BoolToVis}}"/>
                                                                </StackPanel>
                                                                <Border Grid.Column="1" BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="1,0,1,0" Padding="4,0">
                                                                    <ContentControl
                                                                                Content="{Binding Stocky}"
                                                                                ContentTemplate="{StaticResource ArmorPieceEditorTemplate}">
                                                                    <ContentControl.Style>
                                                                        <Style TargetType="ContentControl">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsAny}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ContentControl.Style>
                                                                    </ContentControl>
                                                                </Border>
                                                                <Border Grid.Column="2" BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="0,0,1,0" Padding="4,0">
                                                                    <ContentControl
                                                                                Content="{Binding Slim}"
                                                                                ContentTemplate="{StaticResource ArmorPieceEditorTemplate}">
                                                                    <ContentControl.Style>
                                                                        <Style TargetType="ContentControl">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsAny}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ContentControl.Style>
                                                                    </ContentControl>
                                                                </Border>
                                                                <Border Grid.Column="1" Grid.ColumnSpan="2"
                                                                        BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="1,0,1,0" Padding="4,0">
                                                                    <ContentControl
                                                                                Content="{Binding Any}"
                                                                                ContentTemplate="{StaticResource ArmorPieceEditorTemplate}">
                                                                    <ContentControl.Style>
                                                                        <Style TargetType="ContentControl">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsAny}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ContentControl.Style>
                                                                    </ContentControl>
                                                                </Border>
                                                            </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                <Border x:Name="DropLeftOverlay"
                        Grid.Row="0"
                        Panel.ZIndex="20"
                        Background="#E8FFFFFF"
                        BorderBrush="{StaticResource Accent}"
                        BorderThickness="1.5"
                        CornerRadius="{StaticResource RadiusCard}"
                        Visibility="Collapsed"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="DropLeftTitle" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DropLeftDetail" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="1" Margin="6,0,0,0">
                <local:ModListPanel x:Name="AvailableArmorList"
                                    ItemsSource="{Binding AvailableArmorsView}"
                                    HeaderTitle="可用护甲"
                                    HeaderSummary="{Binding AvailableSummary}"
                                    SearchText="{Binding AvailableSearchText, UpdateSourceTrigger=PropertyChanged}"
                                    SearchActionsTemplate="{StaticResource AvailableArmorSearchActions}"
                                    EmptyMessage="所有护甲都已分配为视觉来源或映射目标。"
                                    SelectionPolicy="Multiple"
                                    RowActions="ArmorAssign"
                                    ArmorAssignToolTip="{Binding AvailableRowActionToolTip}"
                                    RelationshipDragOperation="ArmorRegistryAssign"
                                    SelectionRequested="OnAvailableSelectionRequested"
                                    RowActionInvoked="OnAvailableRowActionInvoked"/>
                <Border x:Name="DropRightOverlay"
                        Panel.ZIndex="20"
                        Background="#E8FFFFFF"
                        BorderBrush="{StaticResource Accent}"
                        BorderThickness="1.5"
                        CornerRadius="{StaticResource RadiusCard}"
                        Visibility="Collapsed"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="DropRightTitle" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DropRightDetail" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
