<UserControl x:Class="HD2ModManager.Views.ArmorRegistryPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HD2ModManager.ViewModels"
             xmlns:lists="clr-namespace:HD2ModManager.Controls.Lists"
             xmlns:local="clr-namespace:HD2ModManager.Views">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <!-- 树的外观与 Mod 详情页的 VPK 组件卡共用一份，避免两处漂移。 -->
            <ResourceDictionary Source="WardrobeTreeResources.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!--
            行容器：外观来自共享字典，本页只额外加"双击展开"这个手势。
        -->
        <Style x:Key="WardrobeTreeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource WardrobeTreeItemStyleBase}">
            <EventSetter Event="MouseDoubleClick" Handler="OnWardrobeTreeItemDoubleClick"/>
        </Style>
        <DataTemplate x:Key="ArmorPieceEditorTemplate">
            <Grid Margin="12,8" MinHeight="42">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BodyName" Text="{Binding BodyLabel}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                <CheckBox Grid.Column="1"
                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                          Style="{StaticResource AppToggleSwitch}"
                          ToolTip="启用或停用此 Unit"
                          AutomationProperties.Name="{Binding BodyLabel, StringFormat={}{0} 组件启用}"
                          VerticalAlignment="Center"
                          Margin="6,0,0,0"/>
                <Button Grid.Column="2" Command="{Binding RemoveCommand}"
                        Style="{StaticResource RowIconButton}"
                        Foreground="{StaticResource StatusDanger}"
                        ToolTip="删除 Unit" AutomationProperties.Name="删除 Unit"
                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                        Margin="0">
                    <Path Width="16" Height="16"
                          Data="M3,4 L13,4 M6,4 L6,2 L10,2 L10,4 M5,6 L5.5,13 L10.5,13 L11,6"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4" StrokeLineJoin="Round"/>
                </Button>
                <TextBlock x:Name="UnitId" Grid.Row="1" Grid.ColumnSpan="3"
                           Text="{Binding Unit}" FontFamily="Consolas" FontSize="11"
                           Margin="0,4,0,0" Foreground="{StaticResource TextSecondary}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Unit}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter TargetName="BodyName" Property="Foreground" Value="{StaticResource TextTertiary}"/>
                    <Setter TargetName="UnitId" Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="ArmorPieceHost" TargetType="ContentControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ContentTemplate" Value="{StaticResource ArmorPieceEditorTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ArmorComponentRowTemplate">
            <Border BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="0,0,0,1" Padding="0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.ColumnSpan="2" Margin="12,2,8,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SlotLabel}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="{Binding LayerLabel}" Margin="8,0,0,0" FontSize="11"
                                       Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding StructureActionLabel}"
                                Command="{Binding StructureActionCommand}"
                                Style="{StaticResource AppHeaderTextButton}" FontSize="11"
                                Padding="6,3"
                                Visibility="{Binding CanEditStructure, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <Grid x:Name="BodyPair" Grid.Row="1" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl Content="{Binding Stocky}" Style="{StaticResource ArmorPieceHost}"/>
                        <Border Grid.Column="1" BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="1,0,0,0">
                            <ContentControl Content="{Binding Slim}" Style="{StaticResource ArmorPieceHost}"/>
                        </Border>
                        <StackPanel Margin="12,8" Visibility="{Binding HasMissingStocky, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Stocky · 未配置" Foreground="{StaticResource TextTertiary}" FontSize="12"/>
                            <Button Content="添加 Stocky" Command="{Binding AddMissingStockyCommand}"
                                    Style="{StaticResource AppHeaderTextButton}" HorizontalAlignment="Left"
                                    Padding="0,4" Margin="0,4,0,0"
                                    Visibility="{Binding CanEditStructure, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,8"
                                    Visibility="{Binding HasMissingSlim, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Slim · 未配置" Foreground="{StaticResource TextTertiary}" FontSize="12"/>
                            <Button Content="添加 Slim" Command="{Binding AddMissingSlimCommand}"
                                    Style="{StaticResource AppHeaderTextButton}" HorizontalAlignment="Left"
                                    Padding="0,4" Margin="0,4,0,0"
                                    Visibility="{Binding CanEditStructure, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                    <ContentControl Grid.Row="1" Grid.ColumnSpan="2" Content="{Binding Any}"
                                    Style="{StaticResource ArmorPieceHost}"
                                    Visibility="{Binding IsAny, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAny}" Value="True">
                    <Setter TargetName="BodyPair" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="AvailableArmorSearchActions">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource AppHeaderTextButton}"
                        Content="{Binding AvailableArmorKindFilterText}"
                        ToolTip="循环筛选仅护甲、仅头盔或自动组合"
                        Click="OnCycleAvailableArmorKindFilterClick"
                        Margin="0,0,8,0"/>
                <Button Style="{StaticResource AppHeaderTextButton}"
                        Content="{Binding AvailableArmorUnitFilterText}"
                        ToolTip="按当前活动配置中生效的 Unit 覆盖筛选；无法确认的护甲仅在“全部”中显示"
                        Click="OnCycleAvailableArmorUnitFilterClick"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ArmorKindSearchActions">
            <Button Style="{StaticResource AppHeaderTextButton}"
                    Content="{Binding AvailableArmorKindFilterText}"
                    ToolTip="循环筛选自动组合、仅护甲或仅头盔"
                    Click="OnCycleAvailableArmorKindFilterClick"/>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AppInlineNotice}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource AppSupportingText}" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource AppBadge}" Margin="12,0,0,0">
                    <TextBlock Text="{Binding RevisionText}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Style="{StaticResource AppToggleSwitch}" Content="启用映射" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <Button Style="{StaticResource AppPrimaryButton}" Content="应用" Command="{Binding ApplyCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Margin="0,0,6,0">
                <local:ModListPanel x:Name="ProviderList"
                                    Grid.Row="0"
                                    ItemsSource="{Binding ProvidersView}"
                                    HeaderTitle="视觉来源"
                                    HeaderSummary="{Binding ProvidersSummary}"
                                    SearchText="{Binding ProvidersSearchText, UpdateSourceTrigger=PropertyChanged}"
                                    SearchActionsTemplate="{StaticResource ArmorKindSearchActions}"
                                    EmptyMessage="{Binding ProvidersEmptyMessage}"
                                    SelectionPolicy="Multiple"
                                    RowActions="ArmorRelease, ArmorOpenDetails, ArmorEditComponents, ArmorDeleteCustomModel, ArmorRenameCustomModel"
                                    ArmorReleaseToolTip="解除视觉对象"
                                    ArmorOpenDetailsToolTip="查看映射目标"
                                    ArmorEditComponentsToolTip="编辑视觉组件"
                                    RelationshipDragOperation="ArmorRegistryRelease"
                                    SelectionRequested="OnProviderSelectionRequested"
                                    RowRightClicked="OnProviderRightClicked"
                                    RowActionInvoked="OnProviderRowActionInvoked">
                    <local:ModListPanel.Style>
                        <Style TargetType="local:ModListPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProviderDetailOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:ModListPanel.Style>
                </local:ModListPanel>
                <Grid Grid.Row="0" Visibility="{Binding IsProviderDetailOpen, Converter={StaticResource BoolToVis}}">
                    <local:ModListPanel x:Name="ProviderDetailList"
                                        ItemsSource="{Binding ProviderDetailItemsView}"
                                        HeaderTitle="{Binding ProviderDetailHeaderTitle}"
                                        HeaderSummary="{Binding ProviderDetailSummary}"
                                        SearchText="{Binding ProviderDetailSearchText, UpdateSourceTrigger=PropertyChanged}"
                                        SearchActionsTemplate="{StaticResource ArmorKindSearchActions}"
                                        HeaderTitleClickable="True"
                                        EmptyMessage="此来源尚无目标；可从右侧添加护甲。"
                                        SelectionPolicy="Multiple"
                                        RowActions="ArmorRelease, ArmorEditComponents"
                                        ArmorReleaseToolTip="解除映射目标"
                                        ArmorEditComponentsToolTip="编辑目标组件"
                                        RelationshipDragOperation="ArmorRegistryRelease"
                                        SelectionRequested="OnDetailSelectionRequested"
                                        HeaderTitleClicked="OnBackToProvidersClick"
                                        RowActionInvoked="OnDetailRowActionInvoked"/>
                </Grid>
                <Grid x:Name="ComponentEditorSurface" Grid.Row="0" Background="{StaticResource SurfaceCanvas}"
                      Visibility="{Binding IsComponentEditorOpen, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource CardContainer}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="0,0,0,1"
                                    Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource AppHeaderTextButton}"
                                            HorizontalContentAlignment="Stretch"
                                            Click="OnCloseComponentEditorClick"
                                            ToolTip="返回" AutomationProperties.Name="返回">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Width="16" Height="16" VerticalAlignment="Center"
                                                  Data="M13,8 L3,8 M3,8 L7,4 M3,8 L7,12"
                                                  Stroke="{StaticResource TextSecondary}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding ComponentEditorName}" FontSize="16" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ComponentEditorName}"/>
                                                <TextBlock Text="视觉组件" Foreground="{StaticResource TextSecondary}"
                                                           FontSize="12" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <CheckBox Grid.Column="1"
                                              Margin="16,0,0,0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Content="跟随视觉来源"
                                              IsChecked="{Binding ComponentEditorFollowSource, Mode=TwoWay}"
                                              Visibility="{Binding ComponentEditorIsTarget, Converter={StaticResource BoolToVis}}"
                                              Style="{StaticResource AppToggleSwitch}"/>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!--
                                    组件结构块与「新增组件」行已移除：树本身已经把"用哪些 unit"
                                    和"哪些 section 不可见"放在同一处描述，再摆一份平铺的组件表
                                    只会让同一件事有两个入口。
                                -->
                                <!--
                                    显隐的继承/独立。刻意不叫「跟随视觉来源」：
                                    卡片上原来那个同名开关是**组件结构**的轴（进协议的 target_mode），
                                    这个是 section 显隐的轴，两个概念同名会让人以为改一个另一个也变。
                                -->
                                <StackPanel Grid.Row="0" Margin="14,0,14,6">
                                    <Grid Visibility="{Binding ComponentEditorIsTarget, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="显隐跟随视觉来源"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="关闭后这件护甲用自己的 section 设置，不再跟随来源"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Margin="12,0,0,0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding Wardrobe.FollowSource, Mode=TwoWay}"
                                                  Style="{StaticResource AppToggleSwitch}"
                                                  AutomationProperties.Name="显隐跟随视觉来源"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Wardrobe.StatusMessage}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="11"
                                               Visibility="{Binding Wardrobe.HasStatus, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <!--
                                    树占满卡片剩下的高度（之前给了 MaxHeight，底部就空出一截）。
                                    它自己滚动，外层不再套 ScrollViewer——两层滚动条只会互相抢滚轮。
                                -->
                                <TreeView Grid.Row="1"
                                          ItemsSource="{Binding Wardrobe.Roots}"
                                          ItemTemplate="{StaticResource WardrobeTreeNodeTemplate}"
                                          ItemContainerStyle="{StaticResource WardrobeTreeItemStyle}"
                                          Margin="6,0,6,0"
                                          Padding="0,2,6,6"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          IsEnabled="{Binding Wardrobe.IsEditable}"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding Wardrobe.HasRoots, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                <!-- 左列 = "设为视觉来源 / 添加映射目标"的拖放区。盖在组件编辑器之上。 -->
                <lists:DropHintOverlay x:Name="ProviderDropOverlay" Grid.Row="0" Panel.ZIndex="20"/>
            </Grid>

            <Grid Grid.Column="1" Margin="6,0,0,0">
                <local:ModListPanel x:Name="AvailableArmorList"
                                    ItemsSource="{Binding AvailableArmorsView}"
                                    HeaderTitle="可用护甲"
                                    HeaderSummary="{Binding AvailableSummary}"
                                    SearchText="{Binding AvailableSearchText, UpdateSourceTrigger=PropertyChanged}"
                                    SearchActionsTemplate="{StaticResource AvailableArmorSearchActions}"
                                    EmptyMessage="{Binding AvailableEmptyMessage}"
                                    SelectionPolicy="Multiple"
                                    RowActions="ArmorAssign"
                                    ArmorAssignToolTip="{Binding AvailableRowActionToolTip}"
                                    RelationshipDragOperation="ArmorRegistryAssign"
                                    SelectionRequested="OnAvailableSelectionRequested"
                                    RowActionInvoked="OnAvailableRowActionInvoked"/>
                <!-- 右列 = "解除管理"的拖放区；叠层本身由 DropHintOverlay 统一渲染。 -->
                <lists:DropHintOverlay x:Name="AvailableDropOverlay" Panel.ZIndex="20"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
