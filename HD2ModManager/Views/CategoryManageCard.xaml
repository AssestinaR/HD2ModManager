<UserControl x:Class="HD2ModManager.Views.CategoryManageCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 设置分类弹窗：新建、重命名、删除自建分类。内置分类名字固定，不在这里出现。 -->
    <Border Margin="14" Width="320" Padding="16,14,16,14" CornerRadius="14"
            Background="{StaticResource SurfaceCard}"
            BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="1"
            Effect="{StaticResource ElevatedPanelShadow}">
        <StackPanel>
            <TextBlock Text="设置分类" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Margin="0,2,0,12" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                       Text="管理你自己建的分类。删除后，里面的 Mod 会回到自动识别的分类。"/>

            <TextBlock x:Name="EmptyText" Text="还没有自建分类" Margin="0,0,0,12" FontSize="12"
                       Foreground="{StaticResource TextTertiary}"/>
            <!-- 条目区有上限：自建分类再多也不让卡片一直长到屏幕外（超出就滚动）。 -->
            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" Padding="0,0,2,0">
                <ItemsControl x:Name="Rows" Margin="0,0,0,8" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8" Padding="10,4" Margin="0,0,0,6" Background="{StaticResource SurfaceMuted}">
                            <Grid MinHeight="30">
                                <!-- 浏览态 -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsConfirmingDelete}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CountText}" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource AppQuietButton}" Content="重命名" Click="OnRenameClick"/>
                                        <Button Style="{StaticResource AppQuietButton}" Content="删除" Foreground="{StaticResource StatusDanger}" Click="OnDeleteClick"/>
                                    </StackPanel>
                                </Grid>
                                <!-- 删除确认态 -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConfirmingDelete}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DeleteMessage}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                        <Button Style="{StaticResource AppQuietButton}" Content="确认删除" Foreground="{StaticResource StatusDanger}" Click="OnConfirmDeleteClick"/>
                                        <Button Style="{StaticResource AppQuietButton}" Content="取消" Click="OnCancelDeleteClick"/>
                                    </StackPanel>
                                </Grid>
                                <!-- 编辑态 -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource AppTextBox}" MaxLength="12" Height="30" Padding="8,0"
                                             Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                             PreviewKeyDown="OnEditKeyDown" IsVisibleChanged="OnEditVisibleChanged"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                        <Button Style="{StaticResource AppQuietButton}" Content="保存" Foreground="{StaticResource Accent}" Click="OnSaveClick"/>
                                        <Button Style="{StaticResource AppQuietButton}" Content="取消" Click="OnCancelClick"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="新建分类" FontSize="12" Margin="0,0,0,6" Foreground="{StaticResource TextSecondary}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewBox" Style="{StaticResource AppTextBox}" MaxLength="12" Height="34" Padding="8,0"
                                 PreviewKeyDown="OnNewKeyDown" TextChanged="OnNewTextChanged"/>
                        <Button Grid.Column="1" Style="{StaticResource AppPrimaryButton}" Content="新建" Height="34" Margin="8,0,0,0"
                                Click="OnCreateClick"/>
                    </Grid>
                    <TextBlock x:Name="Hint" Visibility="Collapsed" Margin="2,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource StatusDanger}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
