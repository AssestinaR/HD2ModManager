<UserControl x:Class="HD2ModManager.Views.ModListPanel"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HD2ModManager.Views"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:ImagePlaceholderConverter x:Key="ImagePlaceholder"/>
        <local:RowActionVisibilityConverter x:Key="RowActionVisibility"/>
        <local:DecorationRowActionVisibilityConverter x:Key="DecorationRowActionVisibility"/>
        <local:ModListRowToneBrushConverter x:Key="RowToneBrush"/>
        <DropShadowEffect x:Key="RowActionPillShadow" BlurRadius="8" ShadowDepth="2" Opacity="0.16" Color="#243042"/>
    </UserControl.Resources>
    <DockPanel Background="Transparent">
        <Border x:Name="HeaderCard"
                DockPanel.Dock="Top"
                Style="{StaticResource CardContainer}"
                Margin="{StaticResource CardStackMargin}"
                Visibility="{Binding ShowHeader, ElementName=Root, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="22"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderTitleElement"
                           Text="{Binding HeaderTitle, ElementName=Root}"
                           Style="{StaticResource AppCardTitle}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="HeaderSearchBox"
                         Grid.Column="0"
                         Style="{StaticResource AppSearchBox}"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Visibility="Collapsed"
                         Opacity="0"
                         Text="{Binding SearchText, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="搜索名称或备注"/>
                <Button Grid.Column="1"
                        Style="{StaticResource AppSearchToggleButton}"
                        ToolTip="显示或隐藏搜索"
                        Click="OnToggleSearchClick"/>
                <TextBlock x:Name="HeaderSummaryElement"
                           Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding HeaderSummary, ElementName=Root}"
                           Style="{StaticResource AppSupportingText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <ContentPresenter x:Name="HeaderSearchActions"
                                  Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  Content="{Binding DataContext, ElementName=Root}"
                                  ContentTemplate="{Binding SearchActionsTemplate, ElementName=Root}"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"
                                  Opacity="0"/>
            </Grid>
        </Border>
        <Border Style="{StaticResource CardContainer}" Padding="0">
            <Grid ClipToBounds="True">
            <Grid x:Name="ActivePresentationLayer">
            <ListBox x:Name="ItemsList" ItemsSource="{Binding PresentedItems, ElementName=Root}"
                     PreviewMouseLeftButtonDown="OnListBackgroundMouseDown"
                     PreviewMouseLeftButtonUp="OnItemsListPreviewMouseLeftButtonUp"
                     PreviewMouseMove="OnItemsListPreviewMouseMove"
                     PreviewMouseWheel="OnItemsListPreviewMouseWheel"
                     LostMouseCapture="OnItemsListLostMouseCapture"
                     SelectionMode="Multiple"
                     ScrollViewer.VerticalScrollBarVisibility="{Binding VerticalScrollBarVisibility, ElementName=Root}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ClipToBounds="False">
                        <Border x:Name="RowBack"
                                Style="{StaticResource ModListRowContainer}"
                                MouseLeftButtonUp="OnRowClick"
                                MouseRightButtonUp="OnRowRightClick">
                            <Border.ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding RowPresentation.Note}" TextWrapping="Wrap"
                                               Visibility="{Binding RowPresentation.HasNote, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding RowPresentation.Summary}" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <Grid ClipToBounds="True" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          Style="{StaticResource AppCheckBox}"
                                          IsChecked="{Binding IsSelected}"
                                          IsHitTestVisible="False"
                                          VerticalAlignment="Center"
                                          Margin="0,0,9,0"
                                          Visibility="{Binding ShowSelectionCheckbox, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
                                <Border Grid.Column="1" Width="36" Height="36"
                                        CornerRadius="{StaticResource RadiusControl}"
                                        ClipToBounds="True"
                                        VerticalAlignment="Center"
                                        Margin="0,0,9,0"
                                        Background="{StaticResource SurfaceMuted}">
                                    <Image Source="{Binding ImagePath, Converter={StaticResource ImagePlaceholder}, ConverterParameter=72}"
                                           Stretch="UniformToFill"/>
                                </Border>
                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <Grid Grid.Row="1" Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding RowPresentation.TypeLabel}"
                                                   Foreground="{Binding RowPresentation.TypeTone, Converter={StaticResource RowToneBrush}}"
                                                   FontSize="12"
                                                   Margin="0,0,7,0"
                                                   Visibility="{Binding RowPresentation.HasType, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding RowPresentation.ActivationLabel}"
                                                   Foreground="{Binding RowPresentation.ActivationTone, Converter={StaticResource RowToneBrush}}"
                                                   FontSize="12"
                                                   Margin="0,0,7,0"
                                                   Visibility="{Binding RowPresentation.HasActivation, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding RowPresentation.OrderLabel}"
                                                   Foreground="{Binding RowPresentation.OrderTone, Converter={StaticResource RowToneBrush}}"
                                                   FontSize="12"
                                                   Margin="0,0,7,0"
                                                   Visibility="{Binding RowPresentation.HasOrder, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding RowPresentation.WarningLabel}"
                                                   Foreground="{Binding RowPresentation.WarningTone, Converter={StaticResource RowToneBrush}}"
                                                   FontSize="12"
                                                   Margin="0,0,7,0"
                                                   Visibility="{Binding RowPresentation.HasWarning, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding RowPresentation.Summary}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="12"
                                                   MaxWidth="260"
                                                   Margin="0,0,7,0"
                                                   MinWidth="0"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding RowPresentation.HasSummary, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding RowPresentation.Note}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="12"
                                                   MinWidth="0"
                                                   HorizontalAlignment="Right"
                                                   TextAlignment="Right"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding RowPresentation.HasNote, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Grid>
                                <Border x:Name="ActionPanel" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Height="32" Padding="2" Margin="0,0,2,0" CornerRadius="16"
                                        Background="{StaticResource SurfaceCard}" Opacity="0" IsHitTestVisible="False"
                                        Effect="{StaticResource RowActionPillShadow}"
                                        Visibility="{Binding HasRowActions, ElementName=Root, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Tag="{x:Static local:ModListRowAction.Rename}" ToolTip="重命名" Style="{StaticResource RowIconButton}" Margin="0" Click="OnRowActionClick"
                                                Visibility="{Binding RowActions, ElementName=Root, Converter={StaticResource RowActionVisibility}, ConverterParameter={x:Static local:ModListRowAction.Rename}}">
                                            <Path Width="16" Height="16" Data="M3,12.5 L3,14 L4.5,14 L13,5.5 L10.5,3 Z M9.5,4 L12,6.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                                        </Button>
                                        <Button Tag="{x:Static local:ModListRowAction.Details}" ToolTip="查看详情" Style="{StaticResource RowIconButton}" Margin="0" Click="OnRowActionClick"
                                                Visibility="{Binding RowActions, ElementName=Root, Converter={StaticResource RowActionVisibility}, ConverterParameter={x:Static local:ModListRowAction.Details}}">
                                            <Path Width="16" Height="16" Data="M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 M8,6 L8,11 M8,4 L8,4.2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round"/>
                                        </Button>
                                        <Button Tag="{x:Static local:ModListRowAction.AddToProfile}" ToolTip="加入正在编辑的配置" Style="{StaticResource RowIconButton}" Margin="0" Click="OnRowActionClick"
                                                >
                                            <Button.Visibility>
                                                <MultiBinding Converter="{StaticResource DecorationRowActionVisibility}" ConverterParameter="{x:Static local:ModListRowAction.AddToProfile}">
                                                    <Binding Path="RowActions" ElementName="Root"/>
                                                    <Binding Path="CanJoinProfile"/>
                                                </MultiBinding>
                                            </Button.Visibility>
                                            <Path Width="16" Height="16" Data="M8,2 L8,14 M2,8 L14,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round"/>
                                        </Button>
                                        <Button Tag="{x:Static local:ModListRowAction.ToggleDecoration}" ToolTip="启用或禁用装饰" Style="{StaticResource RowIconButton}" Margin="0" Click="OnRowActionClick"
                                                >
                                            <Button.Visibility>
                                                <MultiBinding Converter="{StaticResource DecorationRowActionVisibility}" ConverterParameter="{x:Static local:ModListRowAction.ToggleDecoration}">
                                                    <Binding Path="RowActions" ElementName="Root"/>
                                                    <Binding Path="IsAttachable"/>
                                                </MultiBinding>
                                            </Button.Visibility>
                                            <Path Width="16" Height="16" Data="M8,1.5 L8,8 M4,3.5 A6,6 0 1 0 12,3.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round"/>
                                        </Button>
                                        <Button Tag="{x:Static local:ModListRowAction.OpenFolder}" ToolTip="打开文件夹" Style="{StaticResource RowIconButton}" Margin="0" Click="OnRowActionClick"
                                                Visibility="{Binding RowActions, ElementName=Root, Converter={StaticResource RowActionVisibility}, ConverterParameter={x:Static local:ModListRowAction.OpenFolder}}">
                                            <Path Width="16" Height="16" Data="M1.5,5 L6.5,5 L8,3 L14.5,3 L14.5,13 L1.5,13 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                                        </Button>
                                        <Button Tag="{x:Static local:ModListRowAction.MoveUp}" ToolTip="上移" Style="{StaticResource RowIconButton}" Margin="0" Click="OnRowActionClick"
                                                Visibility="{Binding RowActions, ElementName=Root, Converter={StaticResource RowActionVisibility}, ConverterParameter={x:Static local:ModListRowAction.MoveUp}}">
                                            <Path Width="16" Height="16" Data="M8,13 L8,3 M3.5,7.5 L8,3 L12.5,7.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                        </Button>
                                        <Button Tag="{x:Static local:ModListRowAction.MoveDown}" ToolTip="下移" Style="{StaticResource RowIconButton}" Margin="0" Click="OnRowActionClick"
                                                Visibility="{Binding RowActions, ElementName=Root, Converter={StaticResource RowActionVisibility}, ConverterParameter={x:Static local:ModListRowAction.MoveDown}}">
                                            <Path Width="16" Height="16" Data="M8,3 L8,13 M3.5,8.5 L8,13 L12.5,8.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                        </Button>
                                        <Button Tag="{x:Static local:ModListRowAction.RemoveFromProfile}" ToolTip="从配置移除" Style="{StaticResource RowIconButton}" Margin="0" Foreground="{StaticResource StatusDanger}" Click="OnRowActionClick"
                                                Visibility="{Binding RowActions, ElementName=Root, Converter={StaticResource RowActionVisibility}, ConverterParameter={x:Static local:ModListRowAction.RemoveFromProfile}}">
                                            <Path Width="16" Height="16" Data="M3,8 L13,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round"/>
                                        </Button>
                                        <Button Tag="{x:Static local:ModListRowAction.DeleteFromLibrary}" ToolTip="从模组库彻底删除" Style="{StaticResource RowIconButton}" Margin="0" Foreground="{StaticResource StatusDanger}" Click="OnRowActionClick"
                                                Visibility="{Binding RowActions, ElementName=Root, Converter={StaticResource RowActionVisibility}, ConverterParameter={x:Static local:ModListRowAction.DeleteFromLibrary}}">
                                            <Path Width="16" Height="16" Data="M3,5 L13,5 M6,5 L6,3 L10,3 L10,5 M4.5,5 L5,14 L11,14 L11.5,5 M7,7.5 L7,11.5 M9,7.5 L9,11.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Border x:Name="SelectedIndicator"
                                Width="4"
                                Height="30"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="1,0,0,0"
                                Background="{StaticResource Accent}"
                                CornerRadius="2"
                                Opacity="0"
                                IsHitTestVisible="False"
                                Panel.ZIndex="1"
                                Loaded="OnSelectionIndicatorLoaded"
                                Unloaded="OnSelectionIndicatorUnloaded"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="0"/>
                            </Border.RenderTransform>
                        </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="RowBack" Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBack" Property="Background" Value="{StaticResource SurfaceInteractiveHover}"/>
                                <Setter TargetName="RowBack" Property="BorderBrush" Value="{StaticResource StrokeFocus}"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, ElementName=RowBack}" Value="True"/>
                                    <Condition Binding="{Binding HasRowActions, ElementName=Root}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="ActionPanel" Property="Opacity" Value="1"/>
                                <Setter TargetName="ActionPanel" Property="IsHitTestVisible" Value="True"/>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActionPanel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActionPanel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="RowBack" Property="Background" Value="{StaticResource SurfaceSelected}"/>
                                <Setter TargetName="RowBack" Property="BorderBrush" Value="{StaticResource StrokeFocus}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource ModListBox}"/>
                </ListBox.Style>
            </ListBox>
            <TextBlock Text="{Binding EmptyMessage, ElementName=Root}"
                       Foreground="#888"
                       Margin="16"
                       Panel.ZIndex="5"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPresentedItems, ElementName=Root}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            </Grid>
            <!--
                Bulk filters keep the old viewport as a real, virtualized ListBox
                while the active ListBox prepares the next projection underneath.
                This avoids bitmap snapshots and lets both sides genuinely fade.
            -->
            <Grid x:Name="OutgoingPresentationLayer"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"
                  Panel.ZIndex="10">
                <ListBox x:Name="OutgoingItemsList"
                         ItemsSource="{Binding OutgoingPresentedItems, ElementName=Root}"
                         ItemTemplate="{Binding ItemTemplate, ElementName=ItemsList}"
                         Style="{StaticResource ModListBox}"
                         SelectionMode="Multiple"
                         Focusable="False"
                         IsTabStop="False"
                         ScrollViewer.VerticalScrollBarVisibility="{Binding VerticalScrollBarVisibility, ElementName=Root}"/>
                <TextBlock Text="{Binding EmptyMessage, ElementName=Root}"
                           Foreground="#888"
                           Margin="16"
                           Panel.ZIndex="5"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasOutgoingPresentedItems, ElementName=Root}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Canvas x:Name="TransitionOverlay" IsHitTestVisible="False" Panel.ZIndex="20"/>
            <Canvas x:Name="DropOverlay" IsHitTestVisible="False" Panel.ZIndex="30">
                <Border x:Name="DropInsertionIndicator" Height="2" Background="{StaticResource Accent}"
                        Visibility="Collapsed" IsHitTestVisible="False"/>
            </Canvas>
            <Border x:Name="ExternalProfileDropOverlay" Panel.ZIndex="40" Visibility="Collapsed"
                    Background="#D9FFFFFF" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}"
                    IsHitTestVisible="False" Opacity="0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ExternalDropTitle, ElementName=Root}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ExternalDropDetail, ElementName=Root}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
