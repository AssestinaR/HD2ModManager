<UserControl x:Class="HD2ModManager.Views.ModListPanel"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HD2ModManager.Views"
             xmlns:lists="clr-namespace:HD2ModManager.Controls.Lists"
             xmlns:empty="clr-namespace:HD2ModManager.Controls.EmptyState"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <empty:NullOrEmptyToCollapsedConverter x:Key="VisibleWhenText"/>
        <local:ImagePlaceholderConverter x:Key="ImagePlaceholder"/>
        <lists:RowActionListConverter x:Key="RowActionList"/>
        <local:ModListRowToneBrushConverter x:Key="RowToneBrush"/>
        <DropShadowEffect x:Key="RowActionPillShadow" BlurRadius="8" ShadowDepth="2" Opacity="0.16" Color="#243042"/>
        <Style x:Key="ModListHeaderTitle" TargetType="TextBlock" BasedOn="{StaticResource AppCardTitle}">
            <Setter Property="Cursor" Value="Arrow"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HeaderTitleClickable, ElementName=Root}" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel Background="Transparent">
        <Border x:Name="HeaderCard"
                DockPanel.Dock="Top"
                Style="{StaticResource CardContainer}"
                Margin="{StaticResource CardStackMargin}"
                Visibility="{Binding ShowHeader, ElementName=Root, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="22"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderTitleElement"
                           Text="{Binding HeaderTitle, ElementName=Root}"
                           Style="{StaticResource ModListHeaderTitle}"
                           VerticalAlignment="Center"
                           MouseLeftButtonUp="OnHeaderTitleClick"/>
                <TextBox x:Name="HeaderSearchBox"
                         Grid.Column="0"
                         Style="{StaticResource AppSearchBox}"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Visibility="Collapsed"
                         Opacity="0"
                         Text="{Binding SearchText, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="搜索名称或备注"/>
                <Button Grid.Column="1"
                        Style="{StaticResource AppSearchToggleButton}"
                        ToolTip="显示或隐藏搜索"
                        Click="OnToggleSearchClick"/>
                <TextBlock x:Name="HeaderSummaryElement"
                           Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding HeaderSummary, ElementName=Root}"
                           Style="{StaticResource AppSupportingText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <ContentPresenter x:Name="HeaderSearchActions"
                                  Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  Content="{Binding DataContext, ElementName=Root}"
                                  ContentTemplate="{Binding SearchActionsTemplate, ElementName=Root}"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"
                                  Opacity="0"/>
            </Grid>
        </Border>
        <Border Style="{StaticResource CardContainer}" Padding="0">
            <Grid ClipToBounds="True">
            <Grid x:Name="ActivePresentationLayer">
            <ListBox x:Name="ItemsList" ItemsSource="{Binding PresentedItems, ElementName=Root}"
                     PreviewMouseLeftButtonDown="OnListBackgroundMouseDown"
                     PreviewMouseLeftButtonUp="OnItemsListPreviewMouseLeftButtonUp"
                     PreviewMouseMove="OnItemsListPreviewMouseMove"
                     PreviewMouseWheel="OnItemsListPreviewMouseWheel"
                     LostMouseCapture="OnItemsListLostMouseCapture"
                     SelectionMode="Multiple"
                     ScrollViewer.VerticalScrollBarVisibility="{Binding VerticalScrollBarVisibility, ElementName=Root}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ClipToBounds="False">
                        <Border x:Name="RowBack"
                                Style="{StaticResource ModListRowContainer}"
                                MouseLeftButtonUp="OnRowClick"
                                MouseRightButtonUp="OnRowRightClick">
                            <Border.ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding RowPresentation.Note}" TextWrapping="Wrap"
                                               Visibility="{Binding RowPresentation.HasNote, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding RowPresentation.Summary}" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <Grid ClipToBounds="True" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          Style="{StaticResource AppCheckBox}"
                                          IsChecked="{Binding IsSelected}"
                                          IsHitTestVisible="False"
                                          VerticalAlignment="Center"
                                          Margin="0,0,9,0"
                                          Visibility="{Binding ShowSelectionCheckbox, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
                                <Border Grid.Column="1" Width="36" Height="36"
                                        CornerRadius="{StaticResource RadiusControl}"
                                        ClipToBounds="True"
                                        VerticalAlignment="Center"
                                        Margin="0,0,9,0"
                                        Background="{StaticResource SurfaceMuted}">
                                    <Image Source="{Binding ImagePath, Converter={StaticResource ImagePlaceholder}, ConverterParameter=72}"
                                           Stretch="UniformToFill"/>
                                </Border>
                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <Grid Grid.Row="1" Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding RowPresentation.TypeLabel}"
                                                   Foreground="{Binding RowPresentation.TypeTone, Converter={StaticResource RowToneBrush}}"
                                                   FontSize="12"
                                                   Margin="0,0,7,0"
                                                   Visibility="{Binding RowPresentation.HasType, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding RowPresentation.ActivationLabel}"
                                                   Foreground="{Binding RowPresentation.ActivationTone, Converter={StaticResource RowToneBrush}}"
                                                   FontSize="12"
                                                   Margin="0,0,7,0"
                                                   Visibility="{Binding RowPresentation.HasActivation, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding RowPresentation.OrderLabel}"
                                                   Foreground="{Binding RowPresentation.OrderTone, Converter={StaticResource RowToneBrush}}"
                                                   FontSize="12"
                                                   Margin="0,0,7,0"
                                                   Visibility="{Binding RowPresentation.HasOrder, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding RowPresentation.WarningLabel}"
                                                   Foreground="{Binding RowPresentation.WarningTone, Converter={StaticResource RowToneBrush}}"
                                                   FontSize="12"
                                                   Margin="0,0,7,0"
                                                   Visibility="{Binding RowPresentation.HasWarning, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding RowPresentation.Summary}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="12"
                                                   MaxWidth="260"
                                                   Margin="0,0,7,0"
                                                   MinWidth="0"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding RowPresentation.HasSummary, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding RowPresentation.Note}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="12"
                                                   MinWidth="0"
                                                   HorizontalAlignment="Right"
                                                   TextAlignment="Right"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding RowPresentation.HasNote, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Grid>
                                <Border x:Name="ActionPanel" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Height="32" Padding="2" Margin="0,0,2,0" CornerRadius="16"
                                        Background="{StaticResource SurfaceCard}" Opacity="0" IsHitTestVisible="False"
                                        Effect="{StaticResource RowActionPillShadow}"
                                        Visibility="{Binding HasRowActions, ElementName=Root, Converter={StaticResource BoolToVis}}">
                                    <!--
                                        行内动作完全由声明生成：宿主给 flags，行给抑制集合，
                                        ModListRowActionCatalog 给图标/文案/线宽/危险色。
                                        加一个动作 = 枚举 + catalog 一行 + RowIcon.* 几何，
                                        这里一行都不用改。
                                    -->
                                    <ItemsControl Focusable="False">
                                        <ItemsControl.ItemsSource>
                                            <MultiBinding Converter="{StaticResource RowActionList}">
                                                <Binding Path="RowActions" ElementName="Root"/>
                                                <Binding/>
                                                <Binding ElementName="Root"/>
                                            </MultiBinding>
                                        </ItemsControl.ItemsSource>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Tag="{Binding}"
                                                        ToolTip="{Binding ToolTip}"
                                                        Margin="0"
                                                        Click="OnRowActionClick">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource RowIconButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource StatusDanger}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Path Width="16" Height="16"
                                                          Data="{Binding Icon}"
                                                          StrokeThickness="{Binding StrokeThickness}"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                        </Border>
                        <Border x:Name="SelectedIndicator"
                                Width="4"
                                Height="30"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="1,0,0,0"
                                Background="{StaticResource Accent}"
                                CornerRadius="2"
                                Opacity="0"
                                IsHitTestVisible="False"
                                Panel.ZIndex="1"
                                Loaded="OnSelectionIndicatorLoaded"
                                Unloaded="OnSelectionIndicatorUnloaded"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="0"/>
                            </Border.RenderTransform>
                        </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="RowBack" Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBack" Property="Background" Value="{StaticResource SurfaceRowHover}"/>
                                <Setter TargetName="RowBack" Property="BorderBrush" Value="{StaticResource StrokeRowHover}"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, ElementName=RowBack}" Value="True"/>
                                    <Condition Binding="{Binding HasRowActions, ElementName=Root}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="ActionPanel" Property="Opacity" Value="1"/>
                                <Setter TargetName="ActionPanel" Property="IsHitTestVisible" Value="True"/>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActionPanel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActionPanel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="RowBack" Property="Background" Value="{StaticResource SurfaceSelected}"/>
                                <Setter TargetName="RowBack" Property="BorderBrush" Value="{StaticResource StrokeFocus}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource ModListBox}"/>
                </ListBox.Style>
            </ListBox>
            <!--
                空状态有两种来源：宿主给了 EmptyState（图标 + 标题 + 解释 + 可选动作）就渲染它；
                只给了 EmptyMessage 的老页面仍然显示一行文字，颜色从 #888 提到 TextSecondary
                （3.54:1 → 5.38:1）。
            -->
            <empty:EmptyStateView State="{Binding EffectiveEmptyState, ElementName=Root}"
                                  Panel.ZIndex="5">
                <empty:EmptyStateView.Style>
                    <Style TargetType="empty:EmptyStateView">
                        <Setter Property="Visibility"
                                Value="{Binding EffectiveEmptyState, ElementName=Root, Converter={StaticResource VisibleWhenText}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPresentedItems, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </empty:EmptyStateView.Style>
            </empty:EmptyStateView>

            <TextBlock Text="{Binding EmptyMessage, ElementName=Root}"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="16"
                       Panel.ZIndex="5"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasPresentedItems, ElementName=Root}" Value="False"/>
                                    <Condition Binding="{Binding EffectiveEmptyState, ElementName=Root}" Value="{x:Null}"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            </Grid>
            <!--
                Bulk filters keep the old viewport as a real, virtualized ListBox
                while the active ListBox prepares the next projection underneath.
                This avoids bitmap snapshots and lets both sides genuinely fade.

                这一层故意不渲染空态：它只在整批替换（removed + inserted >= 16）
                时出现，承载的是**旧**投影。旧投影为空就等于没有东西要淡出，
                此时画任何文案都只能是新状态的文案，属于谎报；留空、让新投影
                自己淡入才是对的。
            -->
            <Grid x:Name="OutgoingPresentationLayer"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"
                  Panel.ZIndex="10">
                <ListBox x:Name="OutgoingItemsList"
                         ItemsSource="{Binding OutgoingPresentedItems, ElementName=Root}"
                         ItemTemplate="{Binding ItemTemplate, ElementName=ItemsList}"
                         Style="{StaticResource ModListBox}"
                         SelectionMode="Multiple"
                         Focusable="False"
                         IsTabStop="False"
                         ScrollViewer.VerticalScrollBarVisibility="{Binding VerticalScrollBarVisibility, ElementName=Root}"/>
            </Grid>
            <Canvas x:Name="TransitionOverlay" IsHitTestVisible="False" Panel.ZIndex="20"/>
            <Canvas x:Name="DropOverlay" IsHitTestVisible="False" Panel.ZIndex="30">
                <Border x:Name="DropInsertionIndicator" Height="2" Background="{StaticResource Accent}"
                        Visibility="Collapsed" IsHitTestVisible="False"/>
            </Canvas>
            <!--
                两种拖入叠层都由 DropHintOverlay 渲染，宿主只给文案：
                - ExternalDropOverlay：配置页方向（从库拖到配置 / 从配置拖回库）。
                - RelationshipDropOverlay：关系拖放方向（设为选项 / 护甲映射），
                  由 AcceptsRelationshipDrop 声明参与哪种操作。
            -->
            <lists:DropHintOverlay x:Name="ExternalDropOverlay" Panel.ZIndex="40"/>
            <lists:DropHintOverlay x:Name="RelationshipDropOverlay" Panel.ZIndex="45"/>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
