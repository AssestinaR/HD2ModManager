<UserControl x:Class="HD2ModManager.Views.CategoryChipBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        分类芯片条：DataContext 是 ModCategoryFilter。它是标题卡里"分类模式"的内容——
        占位与标题/搜索框同一个位置，所以按可用宽高换行，装不下时纵向滚动。
        末尾的"设置分类"芯片打开自建分类的管理弹窗（新建 / 重命名 / 删除）。
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <ScrollViewer x:Name="Scroller"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Focusable="False"
                  Padding="0,1,0,1"
                  Visibility="{Binding HasChips, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
        <ItemsControl ItemsSource="{Binding Chips}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,6,5">
                        <Button Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Padding="9,2"
                                Cursor="Hand"
                                BorderThickness="1"
                                Click="OnChipClick">
                            <!-- 只有末尾的"设置分类"芯片带图标；分类芯片只显示名字和数量，
                                 图标多了反而看不出哪个是筛选、哪个是操作。 -->
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- 和行内动作同一个图标、同一种绘制方式：16px 画布、
                                         不拉伸（按几何自身坐标画）。用 Stretch 会按包围盒归一化，
                                         质心相对包围盒的偏移就会留着，看着就不居中。 -->
                                    <Path Width="16" Height="16"
                                          Margin="0,0,5,0"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource RowIcon.Category}"
                                          StrokeThickness="1.4"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="{Binding IsAdd, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="12"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource SurfaceMuted}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource StrokeSubtle}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdd}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Accent}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
