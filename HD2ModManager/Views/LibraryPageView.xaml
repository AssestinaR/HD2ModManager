<UserControl x:Class="HD2ModManager.Views.LibraryPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HD2ModManager.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="LibrarySearchActions">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource AppHeaderTextButton}" Content="{Binding OutdatedFilterText}" Click="OnToggleOutdatedFilterClick"/>
                <Button Style="{StaticResource AppHeaderTextButton}" Content="{Binding DecorationFilterText}" Click="OnToggleDecorationFilterClick" Margin="10,0,0,0"/>
                <Button Style="{StaticResource AppHeaderTextButton}" Content="{Binding OptionFilterText}" Click="OnToggleOptionFilterClick" Margin="10,0,0,0"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <!--
        拖放叠层不再由本页绘制：面板自己就是关系拖放的目标，
        这里只声明"参与解除选项关系"并处理放下。
    -->
    <local:ModListPanel x:Name="LibraryModList" ItemsSource="{Binding Items}"
                        HeaderTitle="模组库"
                        HeaderSummary="{Binding ItemCountText}"
                        EmptyState="{Binding EmptyState}"
                        SearchText="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                        SearchActionsTemplate="{StaticResource LibrarySearchActions}"
                        RowActions="Rename, Details, AddToProfile, ToggleDecoration, ExportMod, OpenFolder, DeleteFromLibrary"
                        RowActionInvoked="OnRowActionInvoked"
                        SelectionPolicy="Multiple"
                        RelationshipDragOperation="SetAsOption"
                        AcceptsRelationshipDrop="RemoveOptionParent"
                        RelationshipDropRequested="OnRelationshipDropRequested"
                        AllowExternalProfileDrag="{Binding CanDragToProfile}"
                        AllowExternalProfileRemovalDrop="{Binding CanDragToProfile}"
                        ExternalDropTitle="拖到这里释放以从配置移除"
                        ExternalDropDetail="仅从当前配置移除，不会删除模组文件"
                        ExternalProfileRemovalRequested="OnExternalProfileRemovalRequested"
                        SelectionRequested="OnSelectionRequested"
                        KeyboardCommandRequested="OnKeyboardCommandRequested"
                        RowRightClicked="OnOpenDetailsOnRightClick"
                        BackgroundClicked="OnListBackgroundClick"/>
</UserControl>
