<UserControl x:Class="HD2ModManager.Views.DecorationPlanPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HD2ModManager.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate x:Key="DecorationTargetSearchActions">
            <Button Style="{StaticResource AppHeaderTextButton}"
                    Content="{Binding OptionFilterText}"
                    Click="OnToggleOptionFilterClick"/>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardContainer}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="装饰 Mod 计划" Style="{StaticResource AppCardTitle}"/>
                            <TextBlock Text="来源：{Binding SourceName}" Style="{StaticResource AppSupportingText}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding State}" Style="{StaticResource AppSupportingText}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource AppPrimaryButton}" Content="{Binding SubmitText}" Command="{Binding GenerateCommand}" MinWidth="78" Margin="12,0,0,0" VerticalAlignment="Top"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="目标身形" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource AppComboBox}" ItemsSource="{Binding BodyVariants}" SelectedItem="{Binding TargetBodyVariant}"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="双身形时" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource AppComboBox}" ItemsSource="{Binding DualVariantModes}" SelectedItem="{Binding DualVariantMode}"/>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="目标部位" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource AppComboBox}" ItemsSource="{Binding TargetParts}" SelectedItem="{Binding TargetPart}"/>
                        </Grid>
                        <Grid Grid.Row="3" Margin="0,7,0,0" Visibility="{Binding ShowOutputSettings, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="输出目录" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding OutputDirectory}"/>
                                <Button Grid.Column="1" Style="{StaticResource AppSecondaryButton}" Content="浏览..." Command="{Binding BrowseOutputCommand}" Margin="8,0,0,0"/>
                            </Grid>
                        </Grid>
                        <CheckBox Grid.Row="4" Style="{StaticResource AppCheckBox}" Content="自动导入到 Mod 库" IsChecked="{Binding AutoImport}" Margin="92,9,0,0" Visibility="{Binding ShowOutputSettings, Converter={StaticResource BoolToVis}}"/>
                        <CheckBox Grid.Row="5" Style="{StaticResource AppCheckBox}" Content="来源部位与目标部位完全一致时替换而不注入" IsChecked="{Binding ReplaceWhenSourcePartLayerMatches}" Margin="92,7,0,0"/>
                        <CheckBox Grid.Row="6" Style="{StaticResource AppCheckBox}" Content="包含裁切候选" IsChecked="{Binding ShowPotentialCulling}" Margin="92,7,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource DataTableCard}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource DataTableToolbar}">
                        <DockPanel>
                            <TextBlock Text="来源 Unit（可多选）" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" Text="仅显示非裁切 Unit" Style="{StaticResource AppSupportingText}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <DataGrid Grid.Row="1" Style="{StaticResource DataTableGrid}" ItemsSource="{Binding SourceUnits}" CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="选择" Width="0.65*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><CheckBox Style="{StaticResource AppCheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Unit ID" Binding="{Binding FileId, StringFormat=0x{0:x16}}" Width="1.55*"/>
                            <DataGridTextColumn Header="部位" Binding="{Binding PartKind}" Width="1.0*"/>
                            <DataGridTextColumn Header="身形" Binding="{Binding BodyVariant}" Width="0.9*"/>
                            <DataGridTextColumn Header="层级" Binding="{Binding Layer}" Width="1.0*"/>
                            <DataGridTextColumn Header="尺寸" Binding="{Binding StoredBitsText}" Width="1.15*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <local:ModListPanel Grid.Column="2"
                            HeaderTitle="选择目标 Mod"
                            HeaderSummary="普通 Mod 与选项 Mod 均可作为目标；不提供详情、右键和底栏操作。"
                            EmptyMessage="没有可作为目标的 Mod。"
                            ItemsSource="{Binding TargetMods}"
                            SearchText="{Binding TargetQuery, UpdateSourceTrigger=PropertyChanged}"
                            SearchActionsTemplate="{StaticResource DecorationTargetSearchActions}"
                            SelectionPolicy="Multiple"
                            ShowSelectionCheckbox="True"
                            SelectionRequested="OnSelectionRequested"/>
    </Grid>
</UserControl>
