<UserControl x:Class="HD2ModManager.Views.ModDetailsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HD2ModManager.Views" xmlns:scroll="clr-namespace:HD2ModManager.Controls.Scrolling"
             xmlns:cards="clr-namespace:HD2ModManager.Controls.Cards">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 组件树的外观与护甲映射页共用一份，避免两处长歪。 -->
                <ResourceDictionary Source="WardrobeTreeResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:ImagePlaceholderConverter x:Key="ImagePlaceholder"/>
            <local:AttachmentListMaxHeightConverter x:Key="AttachmentListMaxHeight"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!--
                本页的卡片内容模板。键名约定 CardTemplate.{CardKind}，由 CardStackHost 解析。
                放在页面资源里而不是全局字典，是因为其中几张需要页面代码后置的事件处理
                （修改图像 / 名称 / 备注、VPK 下拉滚轮）。
                卡片外壳、间距、标题、增删动画由 CardStackHost 负责，这里只写内容。
            -->

            <DataTemplate x:Key="CardTemplate.ModHeader">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="96" Height="96"
                            CornerRadius="{StaticResource RadiusCard}"
                            ClipToBounds="True"
                            Background="{StaticResource SurfaceMuted}"
                            Margin="0,0,16,0">
                        <Image Source="{Binding Image, Converter={StaticResource ImagePlaceholder}, ConverterParameter=160}"
                               Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Top"/>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CardTemplate.ModDescription">
                <TextBlock Text="{Binding Description}"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap"/>
            </DataTemplate>

            <!--
                这张卡本身对所有 Mod 都显示（打开文件夹 / 改图像 / 改名 / 改备注是通用操作）；
                只有 patch 级的那几行对 VPK 版 Mod 隐藏——VPK 的 patch 是转换产物，
                在它上面做 patch 级编辑会被下一次转换覆盖。
            -->
            <DataTemplate x:Key="CardTemplate.ModActions">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource AppSecondaryButton}" Content="详情表格"
                                ToolTip="查看 Patch、AssetKey 与诊断信息"
                                Command="{Binding OpenAdvancedDetailsCommand}" Padding="14,6"
                                Visibility="{Binding CanUsePatchTools, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource AppSecondaryButton}" Content="打开文件夹" Command="{Binding OpenFolderCommand}" Padding="14,6"/>
                            <Button Style="{StaticResource AppSecondaryButton}" Content="修改图像" Click="OnSelectImageClick" Padding="14,6" Margin="8,0,0,0"/>
                            <Button Style="{StaticResource AppSecondaryButton}" Content="修改名称" Click="OnEditNameClick" Padding="14,6" Margin="8,0,0,0"/>
                            <Button Style="{StaticResource AppSecondaryButton}" Content="修改备注" Click="OnEditDescriptionClick" Padding="14,6" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,10,0,0"
                               Visibility="{Binding ShowPatchSettingsCard, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource AppSecondaryButton}" Content="修复 patch" Command="{Binding RebuildSameKeyCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource AppSecondaryButton}" Content="生成替换其他护甲的模组" Command="{Binding PlanCrossArmorTransferCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource AppSecondaryButton}" Content="规整护甲patch包" Command="{Binding NormalizeArmorCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource AppSecondaryButton}" Content="Patch 资源重打包" Command="{Binding PatchResourceRepackagingCommand}"/>
                    </WrapPanel>

                    <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,10,0,0"
                               Visibility="{Binding IsDecoration, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource AppSecondaryButton}" Content="重构 patch" Command="{Binding RebuildSameKeyCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource AppSecondaryButton}" Content="编辑装饰 Mod" Command="{Binding EditDecorationCommand}"/>
                    </WrapPanel>

                    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0"
                               Visibility="{Binding CanShowDecorationPlan, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource AppSecondaryButton}" Content="批量生成装饰（以主体 Mod）" Command="{Binding PlanBatchDecorationCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource AppSecondaryButton}" Content="生成装饰 Mod（以来源 Mod）" Command="{Binding PlanDecorationCommand}"/>
                    </WrapPanel>

                    <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,10,0,0"
                               Visibility="{Binding ShowPatchSettingsCard, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource AppSecondaryButton}" Content="头盔合并到盔甲并输出" Command="{Binding PlanHelmetToArmorMergeCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource AppSecondaryButton}" Content="{Binding HelmetMergeToggleText}" Command="{Binding ToggleHelmetToArmorMergeCommand}"/>
                    </WrapPanel>

                    <Button Grid.Row="4" HorizontalAlignment="Right" Margin="0,10,0,0" Style="{StaticResource AppSecondaryButton}"
                            Content="一键转为自定义素体" Command="{Binding ConvertToCustomModelCommand}"
                            Visibility="{Binding ShowPatchSettingsCard, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CardTemplate.VpkActions">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="目标护甲" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource AppComboBox}"
                                  ItemsSource="{Binding VpkTargetArmors}"
                                  SelectedItem="{Binding SelectedVpkTargetArmor, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" MinWidth="200" VerticalAlignment="Center"
                                  scroll:WheelScroll.IsEnabled="True"/>
                        <Button Grid.Column="2" Style="{StaticResource AppSecondaryButton}" Content="切换"
                                Command="{Binding ApplyVpkTargetArmorCommand}" Margin="12,0,0,0" Padding="14,6"/>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="启用 L4N 支持的衣物装饰组件切换"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <CheckBox Grid.Column="1" Style="{StaticResource AppToggleSwitch}"
                                  IsChecked="{Binding EnableVpkComponentTree, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding VpkComponentStatus}" Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding HasVpkComponentStatus, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </DataTemplate>

            <!-- 关掉的 section 不再绘制。改动在点标题右侧「应用」后烘进 patch。 -->
            <DataTemplate x:Key="CardTemplate.VpkComponents">
                <StackPanel>
                    <TextBlock Text="关掉的 section 不再绘制。改动在点「应用」后烘进 patch。"
                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="12"/>
                    <TreeView ItemsSource="{Binding VpkTree.Roots}"
                              ItemTemplate="{StaticResource WardrobeTreeNodeTemplate}"
                              ItemContainerStyle="{StaticResource WardrobeTreeItemStyleBase}"
                              Background="Transparent" BorderThickness="0"
                              Margin="0,8,0,0"
                              MaxHeight="420"
                              scroll:WheelScroll.IsEnabled="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="CardTemplate.DecorationDetails">
                <TextBlock Text="{Binding DecorationSummary}"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap"/>
            </DataTemplate>

            <DataTemplate x:Key="CardTemplate.UserStatus">
                <StackPanel>
                    <TextBlock Text="{Binding UserStatusTitle}"
                               Foreground="{StaticResource Accent}"
                               FontWeight="SemiBold"
                               FontSize="16"/>
                    <TextBlock Text="{Binding UserStatusSummary}"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="CardTemplate.AssetTags">
                <StackPanel>
                    <TextBlock Text="{Binding AssetTagsString}"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DataIndexSummary}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="CardTemplate.ModelCompatibility">
                <StackPanel>
                    <TextBlock Text="模型过时"
                               Foreground="{StaticResource StatusDanger}"
                               FontWeight="SemiBold"
                               FontSize="16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModelOutdated}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding UnitCompatibilitySummary}"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="DetailsScrollViewer" Background="Transparent" scroll:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel>
                <!--
                    卡片由 ViewModel 声明（ModDetailsPageViewModel.Cards），
                    外壳、标题、间距、增删与可见性动画全部由宿主处理。
                -->
                <cards:CardStackHost Cards="{Binding Cards}"/>

                <local:ModListPanel x:Name="HostAttachmentList"
                                    ItemsSource="{Binding HostDecorations}"
                                    HeaderTitle="可为该 Mod 启用的附加选项"
                                    HeaderSummary="已列出支持当前主体的装饰与选项。"
                                    MaxHeight="{Binding ActualHeight, ElementName=DetailsScrollViewer, Converter={StaticResource AttachmentListMaxHeight}}"
                                    VerticalScrollBarVisibility="Auto"
                                    UseInternalScroll="True"
                                    RowActions="Rename, Details, ToggleDecoration, ExportMod, OpenFolder, DeleteFromLibrary"
                                    RowActionInvoked="OnHostDecorationRowActionInvoked"
                                    RowRightClicked="OnHostDecorationOpenDetailsOnRightClick"
                                    SelectionPolicy="Multiple"
                                    SelectionRequested="OnHostDecorationSelectionRequested"
                                    KeyboardCommandRequested="OnHostDecorationKeyboardCommandRequested"
                                    RelationshipDragOperation="RemoveOptionParent"
                                    RelationshipDragSourceHostId="{Binding ModId}"
                                    AllowInternalReorder="{Binding CanReorderHostOptions}"
                                    InternalReorderRequested="OnHostAttachmentInternalReorderRequested"
                                    TransitionStateChanged="OnHostAttachmentTransitionStateChanged"
                                    Visibility="{Binding HasHostDecorations, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="RelationshipDropOverlay"
                Panel.ZIndex="30"
                Margin="{StaticResource CardStackMargin}"
                Background="#E8FFFFFF"
                BorderBrush="{StaticResource Accent}"
                BorderThickness="1.5"
                CornerRadius="{StaticResource RadiusCard}"
                Visibility="Collapsed"
                Opacity="0"
                IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="RelationshipDropTitle"
                           Foreground="{StaticResource TextPrimary}"
                           FontWeight="SemiBold"
                           FontSize="16"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="RelationshipDropDetail"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
