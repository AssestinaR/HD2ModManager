<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:HD2ModManager.ViewModels">

    <!--
        衣柜 / 组件树的**共享外观**。

        为什么抽出来：同一个树在三个地方出现（护甲映射页的视觉组件卡、Mod 详情页的
        VPK 组件卡、将来可能的批量编辑），各写一份必然漂移，而漂移的表现是
        "同一个开关在两个页面长得不一样"，用户会以为它们不是同一件事。

        这里只放**外观**。行容器的交互（双击展开）留在各自页面：它是页面自己的手势，
        不是这套树的语义。
    -->
    <BooleanToVisibilityConverter x:Key="WardrobeBoolToVis"/>

    <!--
        section 树的一个节点。层级：护甲 → 身形 → 槽位 → Unit → section。
        勾选框统一在最右侧、行宽拉伸到卡片右缘（§4.3 的交互约定）；
        点条目本身不改变显隐——避免"想看详情结果改掉了设置"。
        锁链是矢量图，只在 bodyType=Any 的 unit 上出现：它同时挂在健壮和纤细两支下，
        两处切换天然同步，因为状态按 (unit, section 下标) 存、不按节点存。
    -->
    <HierarchicalDataTemplate x:Key="WardrobeTreeNodeTemplate"
                              DataType="{x:Type vm:WardrobeTreeNodeViewModel}"
                              ItemsSource="{Binding Children}">
        <!--
            底色画在模板里而不是容器上：隔行、悬停、选中三者必须按顺序覆盖，
            分在两层里就会出现"选中被隔行盖掉"这类看不清的优先级问题。
            边框粗细恒为 1、默认透明：选中时只换画刷，内容不会被挤动。
        -->
        <Border x:Name="RowBack"
                MinHeight="26"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                CornerRadius="4"
                Padding="6,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Border Margin="8,0,0,0"
                            Padding="5,1"
                            CornerRadius="3"
                            VerticalAlignment="Center"
                            Background="{StaticResource SurfaceCard}"
                            Visibility="{Binding HasPieceTypeLabel, Converter={StaticResource WardrobeBoolToVis}}">
                        <TextBlock Text="{Binding PieceTypeLabel}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="部分"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondary}"
                           ToolTip="该节点下只有一部分 section 被关闭"
                           Visibility="{Binding IsMixed, Converter={StaticResource WardrobeBoolToVis}}"/>
                <!-- 链接标记贴着开关左侧：它说明的是"这一行同时作用于两种身形"，和开关是一件事。 -->
                <Path Grid.Column="2"
                      Width="13" Height="13"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      Stretch="Uniform"
                      Stroke="{StaticResource TextSecondary}"
                      StrokeThickness="1.3"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="M6.5,3.5 L5.5,3.5 A2.6,2.6 0 0 0 5.5,8.7 L6.5,8.7 M9.5,3.5 L10.5,3.5 A2.6,2.6 0 0 1 10.5,8.7 L9.5,8.7 M5.9,6.1 L10.1,6.1"
                      ToolTip="这一行下的 unit 全部同时用于两种身形，改一处等于改两支"
                      Visibility="{Binding SharedAcrossBodies, Converter={StaticResource WardrobeBoolToVis}}"/>
                <CheckBox Grid.Column="3"
                          Margin="12,0,2,0"
                          VerticalAlignment="Center"
                          Style="{StaticResource AppToggleSwitch}"
                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="{Binding Label}"/>
            </Grid>
        </Border>
        <HierarchicalDataTemplate.Triggers>
            <!-- 隔行底色：按当前可见行均匀编号，相邻两行一定不同色。 -->
            <DataTrigger Binding="{Binding IsOddRow}" Value="True">
                <Setter TargetName="RowBack" Property="Background" Value="{StaticResource SurfaceMuted}"/>
            </DataTrigger>
            <Trigger SourceName="RowBack" Property="IsMouseOver" Value="True">
                <Setter TargetName="RowBack" Property="Background" Value="{StaticResource SurfaceInteractiveHover}"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                <Setter TargetName="RowBack" Property="Background" Value="{StaticResource SurfaceSelected}"/>
                <Setter TargetName="RowBack" Property="BorderBrush" Value="{StaticResource StrokeFocus}"/>
            </DataTrigger>
        </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>

    <!--
        行容器：没有小三角（双击展开），整行拉伸，隔行底色 + 悬停 + 选中。
        底色放在容器上而不是模板里，这样悬停/选中/隔行三者只需要在一个地方排优先级。
    -->
    <Style x:Key="WardrobeTreeItemStyleBase" TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,1,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <ContentPresenter x:Name="PART_Header"
                                          ContentSource="Header"
                                          HorizontalAlignment="Stretch"/>
                        <!--
                            层级线：每一层在子块左侧画一条竖线。只靠缩进的话，
                            层级一深就分不清某一行属于哪个父节点；竖线能把归属连起来。
                        -->
                        <Border x:Name="ChildHost"
                                Margin="8,0,0,0"
                                Padding="8,0,0,0"
                                BorderBrush="{StaticResource StrokeSubtle}"
                                BorderThickness="1,0,0,0">
                            <ItemsPresenter x:Name="ItemsHost"/>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ChildHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
