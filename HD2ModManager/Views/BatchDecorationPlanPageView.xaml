<UserControl x:Class="HD2ModManager.Views.BatchDecorationPlanPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HD2ModManager.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="BatchSourceSearchActions">
            <Button Style="{StaticResource AppHeaderTextButton}" Content="{Binding OptionFilterText}" Click="OnToggleOptionFilterClick"/>
        </DataTemplate>
        <DataTemplate x:Key="BatchPlanCardTemplate">
            <StackPanel Margin="0,0,0,10">
                <Border Style="{StaticResource ModListRowContainer}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="{StaticResource RadiusControl}" Background="{StaticResource SurfaceMuted}" Margin="0,0,9,0">
                            <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource AppSupportingText}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardContainer}" Margin="0,6,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="目标身形" VerticalAlignment="Center"/><ComboBox Grid.Column="1" Style="{StaticResource AppComboBox}" ItemsSource="{Binding BodyVariants}" SelectedItem="{Binding TargetBodyVariant}"/></Grid>
                            <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="双身形时" VerticalAlignment="Center"/><ComboBox Grid.Column="1" Style="{StaticResource AppComboBox}" ItemsSource="{Binding DualVariantModes}" SelectedItem="{Binding DualVariantMode}"/></Grid>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="目标部位" VerticalAlignment="Center"/><ComboBox Grid.Column="1" Style="{StaticResource AppComboBox}" ItemsSource="{Binding TargetParts}" SelectedItem="{Binding TargetPart}"/></Grid>
                            <CheckBox Grid.Column="2" Style="{StaticResource AppCheckBox}" Content="来源部位与目标部位完全一致时替换而不注入" IsChecked="{Binding ReplaceWhenSourcePartLayerMatches}" VerticalAlignment="Center"/>
                        </Grid>
                        <DataGrid Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource DataTableGrid}" ItemsSource="{Binding SourceUnits}" CanUserAddRows="False" CanUserDeleteRows="False"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="OnSourceUnitsPreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="选择" Width="54"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource AppCheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="Archive" Binding="{Binding ArchiveId}" Width="1.2*"/>
                                <DataGridTextColumn Header="Unit ID" Binding="{Binding FileId, StringFormat=0x{0:x16}}" Width="1.25*"/>
                                <DataGridTextColumn Header="部位" Binding="{Binding PartKind}" Width="0.8*"/>
                                <DataGridTextColumn Header="身形" Binding="{Binding BodyVariant}" Width="0.75*"/>
                                <DataGridTextColumn Header="层级" Binding="{Binding Layer}" Width="0.85*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.82*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="1.18*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource CardContainer}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="批量装饰计划" Style="{StaticResource AppCardTitle}"/>
                        <TextBlock Text="主体：{Binding HostName}" Style="{StaticResource AppSupportingText}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding State}" Style="{StaticResource AppSupportingText}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="输出目录" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{StaticResource AppTextBox}" Text="{Binding OutputDirectory}"/>
                            <Button Grid.Column="2" Style="{StaticResource AppSecondaryButton}" Content="浏览..." Command="{Binding BrowseOutputCommand}" Margin="8,0,0,0"/>
                        </Grid>
                        <CheckBox Style="{StaticResource AppCheckBox}" Content="自动导入到 Mod 库" IsChecked="{Binding AutoImport}" Margin="72,8,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource AppPrimaryButton}" Content="生成" Command="{Binding GenerateCommand}" MinWidth="78" VerticalAlignment="Top" Margin="12,0,0,0"/>
                </Grid>
            </Border>
            <local:ModListPanel Grid.Row="2" HeaderTitle="选择装饰来源" HeaderSummary="可多选；默认显示选项 Mod。"
                                EmptyMessage="没有可作为装饰来源的 Mod。" ItemsSource="{Binding SourceMods}"
                                SearchText="{Binding SourceQuery, UpdateSourceTrigger=PropertyChanged}"
                                SearchActionsTemplate="{StaticResource BatchSourceSearchActions}"
                                SelectionPolicy="Multiple" ShowSelectionCheckbox="True"
                                SelectionRequested="OnSelectionRequested"/>
        </Grid>
        <local:AnimatedPlanList Grid.Column="2" ItemsSource="{Binding Plans}" ItemTemplate="{StaticResource BatchPlanCardTemplate}"/>
    </Grid>
</UserControl>
