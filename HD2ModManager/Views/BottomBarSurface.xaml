<UserControl x:Class="HD2ModManager.Views.BottomBarSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HD2ModManager.Views"
             xmlns:viewModels="clr-namespace:HD2ModManager.ViewModels"
             HorizontalAlignment="Left"
             VerticalAlignment="Bottom">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate DataType="{x:Type viewModels:CustomModelConversionBottomBarRow}">
            <local:CustomModelConversionBottomBarContent/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:TemporaryEditorBarPresentation}">
            <local:TemporaryEditorBarContent/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:SelectionActionBarPresentation}">
            <local:SelectionActionBarContent/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:MaterialPackagingBottomBarRowViewModel}">
            <local:MaterialPackagingBottomBarContent/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SameKeyRebuildBottomBarRowViewModel}">
            <local:SameKeyRebuildBottomBarContent/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ModExportBottomBarRowViewModel}">
            <local:ModExportBottomBarContent/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SteamVerifyBottomBarViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                <TextBlock Text="{Binding CountdownText}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource TextSecondary}"/>
                <Button Style="{StaticResource AppPrimaryButton}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" Margin="12,0,0,0"/>
                <Button Style="{StaticResource AppSecondaryButton}" Content="{Binding CancelText}" Command="{Binding CancelCommand}" Margin="8,0,14,0"
                        Visibility="{Binding IsCancelVisible, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ModLibrarySwitchBottomBarViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Mod 库目录已更改，保存后将重启应用。" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                <Button Style="{StaticResource AppPrimaryButton}" Content="重启并切换" Command="{Binding RestartCommand}" Margin="12,0,0,0"/>
                <Button Style="{StaticResource AppSecondaryButton}" Content="取消" Command="{Binding CancelCommand}" Margin="8,0,14,0"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid ClipToBounds="True">
        <StackPanel x:Name="ActiveRows" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <Canvas x:Name="OutgoingRows" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
