<UserControl x:Class="HD2ModManager.Views.SectionalEditorPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HD2ModManager.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--
            顶部单行卡：左边"新增组"，右边"应用"。
            这两件事是一组（选块 → 建组 → 应用才生效），放同一行比散在两列里好找。
        -->
        <Border Grid.Row="0" Style="{StaticResource AppCard}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="新增 section 组" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Width="220" Style="{StaticResource AppTextBox}" VerticalAlignment="Center"
                             Text="{Binding Source.NewVpkGroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="新组名"/>
                    <Button Style="{StaticResource AppSecondaryButton}" Content="新建组"
                            Command="{Binding Source.CreateVpkGroupCommand}" Margin="8,0,0,0" Padding="14,6"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="调整后请应用" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                    <Button Style="{StaticResource AppPrimaryButton}" Content="应用"
                            Command="{Binding Source.ApplyVpkComponentsCommand}" Padding="18,6"
                            VerticalAlignment="Center"
                            ToolTip="把当前勾选烘进 patch；之后要重启游戏才生效。"/>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            两列：左 section 树（2/5），右 section 组（3/5）。
            树要显示 unit / section 两层加缩进，但组的每行有名字 + 说明 + 开关 + 删除，更吃横向 ——
            所以组那边给 3/5。
        -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：section 树卡片。树占满标题以外的全部高度（不设 MaxHeight）。 -->
            <Border Grid.Column="0" Style="{StaticResource AppCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="section 树" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Source.VpkSelectionHint}"
                               Margin="0,6,0,0" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11"/>
                    <!-- DockPanel 的最后一个子元素自动填满剩余空间，所以树不用限高。 -->
                    <local:TreeSurface Roots="{Binding Source.VpkTree.Roots}"
                                       Margin="0,10,0,0"
                                       VerticalScrollBarVisibility="Auto"
                                       SelectionChanged="OnTreeSelectionChanged"/>
                </DockPanel>
            </Border>

            <!-- 右：section 组卡片 -->
            <Border Grid.Column="2" Style="{StaticResource AppCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="section 组" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Source.VpkGroupSummary}" Margin="0,6,0,0"
                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="12"
                               Visibility="{Binding Source.HasVpkGroups, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Source.VpkGroupStatus}" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11"
                               Visibility="{Binding Source.HasVpkGroupStatus, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock DockPanel.Dock="Bottom" Text="勾选会立刻保存到 wardrobe.json；点上面的「应用」才烘进 patch，之后要重启游戏才生效。"
                               Margin="0,10,0,0" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <ItemsControl ItemsSource="{Binding Source.VpkGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceMuted}" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <!-- 名字失焦即落盘：组名不参与身份（身份是 id），改名不会影响勾选状态。 -->
                                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Background="Transparent" BorderThickness="0" Padding="0"
                                                         Foreground="{StaticResource TextPrimary}"
                                                         CaretBrush="{StaticResource TextPrimary}"
                                                         AutomationProperties.Name="组名"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                                <!-- 共用 / 失效必须当场说出来，否则两个看起来独立的复选框会骗人。 -->
                                                <TextBlock Text="{Binding StateHint}" FontSize="11"
                                                           Foreground="{StaticResource StatusWarning}" TextWrapping="Wrap"
                                                           Visibility="{Binding HasStateHint, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource AppToggleSwitch}"
                                                      VerticalAlignment="Center" Margin="12,0,2,0"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      AutomationProperties.Name="{Binding Name}"/>
                                            <Button Grid.Column="2" Style="{StaticResource AppSecondaryButton}"
                                                    Content="删除" Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Command="{Binding DeleteCommand}" AutomationProperties.Name="删除组"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
