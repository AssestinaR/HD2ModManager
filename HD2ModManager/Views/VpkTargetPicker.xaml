<UserControl x:Class="HD2ModManager.Views.VpkTargetPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="200">
    <!--
        目标护甲下拉：可输入搜索（名字 / 归档 id）的单选。专属多选已撤（规划 kit-instance-mapping-deploy-plan §15.3）。
        DataContext 是 VpkTargetPickerViewModel。
    -->
    <Grid>
        <Border x:Name="Box" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource StrokeControl}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" MinHeight="32" Padding="6,2"
                Cursor="IBeam" PreviewMouseLeftButtonDown="Box_PreviewMouseLeftButtonDown">
            <DockPanel LastChildFill="True">
                <Path DockPanel.Dock="Right" Width="10" Height="6" Margin="6,0,4,0" VerticalAlignment="Center"
                      Data="M1,1 L5,5 L9,1" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                <Grid VerticalAlignment="Center" MinWidth="90">
                    <TextBlock Text="{Binding SingleText}" Foreground="{StaticResource TextPrimary}" IsHitTestVisible="False"
                               Margin="2,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ShowSingleText, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="输入名字搜索…" Foreground="{StaticResource TextSecondary}" IsHitTestVisible="False"
                               Margin="2,0" VerticalAlignment="Center"
                               Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}"/>
                    <TextBox x:Name="Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Padding="2,4"
                             Foreground="{StaticResource TextPrimary}" TextChanged="Search_TextChanged"
                             PreviewKeyDown="Search_PreviewKeyDown"/>
                </Grid>
            </DockPanel>
        </Border>
        <Popup x:Name="DropPopup" IsOpen="{Binding IsOpen, Mode=TwoWay}" StaysOpen="True" PlacementTarget="{Binding ElementName=Box}"
               Placement="Bottom" AllowsTransparency="True" Width="{Binding ActualWidth, ElementName=Box}">
            <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource StrokeControl}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}" Margin="0,2,0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="没有匹配的护甲" Margin="12,8" Foreground="{StaticResource TextSecondary}"
                               Visibility="{Binding HasNoMatch, Converter={StaticResource BoolToVis}}"/>
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding View}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Background="Transparent" Padding="10,5" Cursor="Hand"
                                            PreviewMouseLeftButtonUp="Row_PreviewMouseLeftButtonUp">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding RowText}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceInteractiveHover}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
