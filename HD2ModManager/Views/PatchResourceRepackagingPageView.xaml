<UserControl x:Class="HD2ModManager.Views.PatchResourceRepackagingPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HD2ModManager.Views" xmlns:scroll="clr-namespace:HD2ModManager.Controls.Scrolling">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="PatchResourceAssetRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConflict}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource StatusDanger}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusDanger}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.82*" MinWidth="250"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="1.05*" MinWidth="300"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="1.55*" MinWidth="430"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      scroll:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel>
                <Border Style="{StaticResource CardContainer}" Margin="{StaticResource CardStackMargin}">
                    <StackPanel>
                        <TextBlock Text="Patch 资源重打包" Style="{StaticResource AppCardTitle}"/>
                        <TextBlock Text="从多个 Mod 的 Patch 组中挑选资源，生成一个只包含批准条目的新 Patch。"
                                   Style="{StaticResource AppSupportingText}"
                                   Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding State}"
                                   Style="{StaticResource AppSupportingText}"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding PatchGroupSummary}"
                                   Style="{StaticResource AppSupportingText}"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardContainer}" Margin="{StaticResource CardStackMargin}">
                    <StackPanel>
                        <TextBlock Text="输出设置" Style="{StaticResource AppCardTitle}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource AppTextBox}"
                                     Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="支持相对目录和绝对目录"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource AppSecondaryButton}"
                                    Content="浏览..."
                                    Command="{Binding BrowseOutputCommand}"
                                    Margin="8,0,0,0"/>
                        </Grid>
                        <CheckBox Style="{StaticResource AppCheckBox}"
                                  Content="生成后自动导入 Mod 库"
                                  IsChecked="{Binding AutoImport}"
                                  Margin="0,10,0,0"/>
                        <Button Style="{StaticResource AppPrimaryButton}"
                                Content="生成"
                                Command="{Binding GenerateCommand}"
                                MinWidth="84"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardContainer}" Margin="{StaticResource CardStackMargin}">
                    <StackPanel>
                        <TextBlock Text="来源 Mod 快捷操作" Style="{StaticResource AppCardTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource AppSecondaryButton}"
                                    Content="全选 Mod"
                                    Command="{Binding SelectAllModsCommand}"/>
                            <Button Style="{StaticResource AppSecondaryButton}"
                                    Content="清空"
                                    Command="{Binding ClearModSelectionCommand}"
                                    Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedModCount, StringFormat=已选择 {0} 个 Mod}"
                                   Style="{StaticResource AppSupportingText}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardContainer}" Margin="{StaticResource CardStackMargin}">
                    <StackPanel>
                        <TextBlock Text="AssetKey 快捷操作" Style="{StaticResource AppCardTitle}"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource AppSecondaryButton}"
                                    Content="全选"
                                    Command="{Binding SelectAllAssetsCommand}"
                                    Margin="0,0,8,8"/>
                            <Button Style="{StaticResource AppSecondaryButton}"
                                    Content="清空"
                                    Command="{Binding ClearAssetSelectionCommand}"
                                    Margin="0,0,8,8"/>
                            <Button Style="{StaticResource AppSecondaryButton}"
                                    Content="反选"
                                    Command="{Binding InvertAssetSelectionCommand}"
                                    Margin="0,0,8,8"/>
                            <Button Style="{StaticResource AppSecondaryButton}"
                                    Content="选择材质/贴图"
                                    Command="{Binding SelectMaterialResourcesCommand}"
                                    Margin="0,0,8,8"/>
                            <Button Style="{StaticResource AppSecondaryButton}"
                                    Content="轮换解决冲突"
                                    Command="{Binding ResolveConflictsCommand}"
                                    Margin="0,0,8,8"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedAssetCount, StringFormat=已选 {0}}" Style="{StaticResource AppSupportingText}"/>
                            <TextBlock Text=" / " Style="{StaticResource AppSupportingText}"/>
                            <TextBlock Text="{Binding AssetCount}" Style="{StaticResource AppSupportingText}"/>
                            <TextBlock Text="；冲突变体 " Style="{StaticResource AppSupportingText}"/>
                            <TextBlock Text="{Binding ConflictCount}" Style="{StaticResource AppSupportingText}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <local:ModListPanel Grid.Column="2"
                            HeaderTitle="选择来源 Mod"
                            HeaderSummary="可多选；一个 Mod 的多个 Patch 组会在右侧合并显示。"
                            EmptyMessage="没有可用于重打包的 Patch Mod。"
                            ItemsSource="{Binding SourceMods}"
                            SearchText="{Binding ModQuery, UpdateSourceTrigger=PropertyChanged}"
                            SelectionPolicy="Multiple"
                            SelectionRequested="OnSelectionRequested"
                            VerticalScrollBarVisibility="Auto"/>

        <Border Grid.Column="4" Style="{StaticResource DataTableCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource DataTableToolbar}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="AssetKey 资源" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedAssetCount, StringFormat=已选 {0} 项}"
                                           Style="{StaticResource AppSupportingText}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource AppHeaderTextButton}"
                                    Content="{Binding ConflictFilterText}"
                                    Command="{Binding ToggleConflictFilterCommand}"/>
                        </Grid>
                        <TextBox Grid.Row="1"
                                 Style="{StaticResource AppSearchBox}"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="搜索 AssetKey、来源 Mod、来源 Patch、类型或引用目标"
                                 Margin="0,8,0,0"/>
                    </Grid>
                </Border>
                <DataGrid Grid.Row="1"
                          Style="{StaticResource DataTableGrid}"
                          ItemsSource="{Binding AssetRows}"
                          RowStyle="{StaticResource PatchResourceAssetRowStyle}"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="选择" Width="54" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource AppCheckBox}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="来源 Mod" Binding="{Binding SourceModText}" Width="1.15*"/>
                        <DataGridTextColumn Header="来源 Patch" Binding="{Binding SourcePatchText}" Width="1.05*"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding TypeName}" Width="0.75*"/>
                        <DataGridTextColumn Header="AssetKey" Binding="{Binding AssetKeyText}" Width="1.2*"/>
                        <DataGridTextColumn Header="引用目标" Binding="{Binding ReferenceTargetsText}" Width="1.35*"/>
                        <DataGridTextColumn Header="尺寸" Binding="{Binding SizeText}" Width="1.45*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
