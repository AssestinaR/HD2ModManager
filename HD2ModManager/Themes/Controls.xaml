<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 作用：集中定义 Manager 的颜色、间距与基础交互控件样式。 -->
    <SolidColorBrush x:Key="SurfaceCanvas" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="SurfaceCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceMuted" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="SurfaceSelected" Color="#EAF1FF"/>
    <SolidColorBrush x:Key="SurfaceInteractiveHover" Color="#EEF4FF"/>
    <!--
        行级悬停单独一组 token：列表行是高频、低承诺的表面，悬停不该借用
        强调色，否则会和"选中"抢同一个视觉通道。选中仍用 SurfaceSelected +
        Accent 描边 + 左侧 4px 条，三者叠加保证灰度下也能分辨。
    -->
    <SolidColorBrush x:Key="SurfaceRowHover" Color="#F7F9FC"/>    <SolidColorBrush x:Key="StrokeRowHover" Color="#DFE5EE"/>
    <SolidColorBrush x:Key="SurfaceElevated" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#20242C"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#626B7A"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#7A8494"/>
    <SolidColorBrush x:Key="StrokeSubtle" Color="#E1E6EF"/>
    <SolidColorBrush x:Key="StrokeControl" Color="#C9D2E0"/>
    <SolidColorBrush x:Key="StrokeFocus" Color="#1E63D6"/>
    <SolidColorBrush x:Key="Accent" Color="#1E63D6"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1757BF"/>
    <SolidColorBrush x:Key="StatusSuccess" Color="#237A3B"/>
    <SolidColorBrush x:Key="StatusWarning" Color="#9A6500"/>
    <SolidColorBrush x:Key="StatusDanger" Color="#B3261E"/>
    <SolidColorBrush x:Key="StatusInfo" Color="#1E63D6"/>
    <Thickness x:Key="Space4">4</Thickness>
    <Thickness x:Key="Space8">8</Thickness>
    <Thickness x:Key="Space12">12</Thickness>
    <Thickness x:Key="Space16">16</Thickness>
    <Thickness x:Key="Space24">24</Thickness>
    <Thickness x:Key="AppControlPadding">10,6</Thickness>
    <CornerRadius x:Key="RadiusControl">6</CornerRadius>
    <CornerRadius x:Key="RadiusItem">10</CornerRadius>
    <CornerRadius x:Key="RadiusCard">14</CornerRadius>
    <DropShadowEffect x:Key="ElevatedPanelShadow" Color="#000000" BlurRadius="18" ShadowDepth="3" Opacity="0.16"/>
    <!-- 浮动操作簇里"当前焦点"那个圆片的加重阴影。 -->
    <DropShadowEffect x:Key="ActionFocusShadow" Color="#101828" BlurRadius="24" ShadowDepth="5" Opacity="0.30"/>

    <!-- 兼容已有页面的历史 key；新增样式仅使用上方的语义 token。 -->
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#20242C"/>
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#626B7A"/>
    <SolidColorBrush x:Key="AppAccentBrush" Color="#1E63D6"/>
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#1757BF"/>
    <SolidColorBrush x:Key="AppControlBorderBrush" Color="#C9D2E0"/>
    <SolidColorBrush x:Key="AppControlSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppDangerBrush" Color="#B3261E"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E1E6EF"/>
    <CornerRadius x:Key="AppControlCornerRadius">6</CornerRadius>

    <Style x:Key="AppCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceCard}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Padding" Value="{StaticResource Space16}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="AppInteractiveCard" TargetType="Border" BasedOn="{StaticResource AppCard}">
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceInteractiveHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource StrokeFocus}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppElevatedPanel" TargetType="Border" BasedOn="{StaticResource AppCard}">
        <Setter Property="Background" Value="{StaticResource SurfaceElevated}"/>
        <Setter Property="Effect" Value="{StaticResource ElevatedPanelShadow}"/>
    </Style>

    <Style x:Key="AppPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style x:Key="AppCardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style x:Key="AppSupportingText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="AppStatusValue" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="AppBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceSelected}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeFocus}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusItem}"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="AppInlineNotice" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceMuted}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusItem}"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>

    <Style x:Key="AppTextBox" TargetType="TextBox">
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceCard}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeControl}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource AppControlCornerRadius}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource StrokeFocus}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Background" Value="#F1F3F6"/><Setter Property="Foreground" Value="#8A919E"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppSecondaryButton" TargetType="Button">
        <Setter Property="Padding" Value="{StaticResource AppControlPadding}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceCard}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeControl}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource AppControlCornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceInteractiveHover}"/><Setter Property="BorderBrush" Value="{StaticResource StrokeFocus}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceSelected}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppPrimaryButton" TargetType="Button" BasedOn="{StaticResource AppSecondaryButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHover}"/><Setter Property="BorderBrush" Value="{StaticResource AccentHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#10499F"/><Setter Property="BorderBrush" Value="#10499F"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppDangerButton" TargetType="Button" BasedOn="{StaticResource AppSecondaryButton}">
        <Setter Property="Foreground" Value="{StaticResource StatusDanger}"/>
        <Setter Property="BorderBrush" Value="#EAB6B2"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFF0EF"/><Setter Property="BorderBrush" Value="{StaticResource StatusDanger}"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppQuietButton" TargetType="Button" BasedOn="{StaticResource AppSecondaryButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceInteractiveHover}"/>
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppIconButton" TargetType="Button" BasedOn="{StaticResource AppQuietButton}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="AppSearchBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
        <Setter Property="Padding" Value="6,0"/>
    </Style>

    <Style x:Key="AppSearchToggleButton" TargetType="Button" BasedOn="{StaticResource AppQuietButton}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16">
                        <Path Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M9.5,8.5 L13.5,12.5 M11,6 A5,5 0 1 1 1,6 A5,5 0 1 1 11,6"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceInteractiveHover}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceSelected}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppHeaderTextButton" TargetType="Button">
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Padding" Value="5,1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentHover}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceInteractiveHover}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceSelected}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppComboBox" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceCard}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeControl}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource AppComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="PART_ToggleButton"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      ClickMode="Press">
                            <Border x:Name="ControlBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource RadiusControl}">
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                    <Path x:Name="Arrow" Width="10" Height="6" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Data="M1,1 L5,5 L9,1" RenderTransformOrigin="0.5,0.5"
                                          Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                        <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                                    </Path>
                                </Grid>
                            </Border>
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               VerticalOffset="-1"
                               PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="{StaticResource SurfaceCard}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusControl}">
                                <ScrollViewer MaxHeight="260" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ControlBorder" Property="BorderBrush" Value="{StaticResource StrokeFocus}"/></Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="ControlBorder" Property="BorderBrush" Value="{StaticResource StrokeFocus}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppCompactComboBox" TargetType="ComboBox" BasedOn="{StaticResource AppComboBox}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

    <Style x:Key="AppCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="16" Height="16" VerticalAlignment="Center" CornerRadius="3"
                                Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource StrokeControl}" BorderThickness="1">
                            <Path x:Name="Check" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource StrokeFocus}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppToggleSwitch" TargetType="CheckBox" BasedOn="{StaticResource AppCheckBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track" Width="36" Height="20" VerticalAlignment="Center" CornerRadius="10"
                                Background="{StaticResource StrokeControl}" BorderBrush="{StaticResource StrokeControl}" BorderThickness="1">
                            <Border x:Name="Thumb" Width="16" Height="16" Margin="1" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="8" Background="White"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource StrokeFocus}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        顶栏图标几何。放在应用级资源里，NavBarHost 用 NavIconGeometryConverter 按
        NavIconKey 取值——这样"加一个图标"是加一条几何 + 一个枚举值，不用在模板里
        再写一组 DataTrigger，也不用把同一段路径抄两遍（激活态/非激活态各一份）。
    -->
    <Geometry x:Key="NavIcon.Home">M2,7 L8,2 L14,7 L14,14 L10,14 L10,10 L6,10 L6,14 L2,14 Z</Geometry>
    <Geometry x:Key="NavIcon.ArmorRegistry">M3,2.5 L13,2.5 L13,13.5 L3,13.5 Z M5,5 L11,5 M5,8 L11,8 M5,11 L9,11</Geometry>
    <Geometry x:Key="NavIcon.Settings">M8,4.5 A3.5,3.5 0 1 0 8,11.5 A3.5,3.5 0 1 0 8,4.5 M8,1.5 L8,3 M8,13 L8,14.5 M1.5,8 L3,8 M13,8 L14.5,8 M3.4,3.4 L4.5,4.5 M11.5,11.5 L12.6,12.6 M12.6,3.4 L11.5,4.5 M4.5,11.5 L3.4,12.6</Geometry>
    <Geometry x:Key="NavIcon.Profile">M3,2.5 L12,2.5 L14,5 L14,13.5 L2,13.5 L2,5 Z M5,7 L11,7 M5,10 L9,10</Geometry>
    <Geometry x:Key="NavIcon.Library">M2,4 L14,4 L14,13 L2,13 Z M2,7 L14,7 M6,4 L6,13</Geometry>

    <!-- 空状态图标。与顶栏图标同一套约定：几何在应用级资源里，控件按枚举取。 -->
    <Geometry x:Key="EmptyIcon.Inbox">M2,4 L14,4 L14,13 L2,13 Z M2,7 L14,7 M6,4 L6,13</Geometry>
    <Geometry x:Key="EmptyIcon.Search">M9.5,8.5 L13.5,12.5 M11,6 A5,5 0 1 1 1,6 A5,5 0 1 1 11,6</Geometry>
    <Geometry x:Key="EmptyIcon.Filter">M1.5,3 L14.5,3 L9.5,8.5 L9.5,13 L6.5,14.5 L6.5,8.5 Z</Geometry>

    <!--
        行内动作图标。同一套约定：几何在这里，ModListRowActionCatalog 按 IconKey 取，
        行模板只有一个按钮的 DataTemplate——加一个动作不再需要在模板里加一个按钮。
    -->
    <Geometry x:Key="RowIcon.Rename">M3,12.5 L3,14 L4.5,14 L13,5.5 L10.5,3 Z M9.5,4 L12,6.5</Geometry>
    <Geometry x:Key="RowIcon.Details">M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 M8,6 L8,11 M8,4 L8,4.2</Geometry>
    <Geometry x:Key="RowIcon.ArmorAssign">M13,8 L3,8 M3,8 L7,4 M3,8 L7,12</Geometry>
    <Geometry x:Key="RowIcon.ArmorRelease">M3,8 L13,8 M13,8 L9,4 M13,8 L9,12</Geometry>
    <Geometry x:Key="RowIcon.ArmorDeleteCustomModel">M3,4 L13,4 M6,4 L6,2 L10,2 L10,4 M5,6 L5.5,13 L10.5,13 L11,6</Geometry>
