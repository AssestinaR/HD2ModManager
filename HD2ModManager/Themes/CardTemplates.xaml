<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cards="clr-namespace:HD2ModManager.Controls.Cards">
    <!--
        作用：卡片内容模板库。键名约定 CardTemplate.{CardKind}。

        这是"卡片长什么样"的唯一落点：逻辑层只给 CardKind，不写任何 XAML。
        本字典刻意只依赖 Themes/Controls.xaml 的语义 token，不引用 App.xaml 里的
        局部资源——它作为 MergedDictionary 加载时，App.xaml 的局部资源还没注册。
    -->

    <!-- 标题行右侧动作的隐式模板：逻辑层只给文案 + 命令。 -->
    <DataTemplate DataType="{x:Type cards:CardHeaderAction}">
        <Button Style="{StaticResource AppSecondaryButton}"
                Content="{Binding Text}"
                Command="{Binding Command}"
                Padding="16,6"/>
    </DataTemplate>


    <!-- 一段纯文本。Data 为 string。 -->
    <DataTemplate x:Key="CardTemplate.Text">
        <TextBlock Text="{Binding}"
                   TextWrapping="Wrap"
                   FontSize="13"
                   LineHeight="21"
                   Foreground="{StaticResource TextPrimary}"/>
    </DataTemplate>

    <!-- 一条提示。Data 为 string。 -->
    <DataTemplate x:Key="CardTemplate.Notice">
        <Border Style="{StaticResource AppInlineNotice}">
            <TextBlock Text="{Binding}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondary}"/>
        </Border>
    </DataTemplate>

    <!-- 键值列表。Data 为 IEnumerable<CardKeyValue>。 -->
    <DataTemplate x:Key="CardTemplate.KeyValueList">
        <ItemsControl ItemsSource="{Binding}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="132"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Value}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

</ResourceDictionary>
