<Project Sdk="Microsoft.NET.Sdk">

  <!--
    作用：把"求生之路 2 / Source 引擎"的角色模型映射到 HD2 的骨架，并产出可安装的补丁。
    Purpose: Maps a Left 4 Dead 2 / Source character model onto the HD2 skeleton and emits installable patches.

    这一层是**唯一同时认识两侧**的地方：
      * 向下引用 HD2SourceModel —— 纯 Source 文件格式读取层，它不认识 HD2；
      * 向上引用 HD2ModAdaptation —— HD2 的 Unit 解析、变换表读取与 Canonical 编译器。
    两个引用都必须在这里出现，而且只在这里出现。这就是"缝"的物理位置：
    改动 Source 侧只碰 HD2SourceModel，改动 HD2 侧只碰 HD2ModAdaptation，
    只有"两侧的对应关系"变了才需要动这个工程。
    This is the only layer that knows both sides: it references the Source reading layer below it
    and the HD2 Unit/patch layer above it.  Both references belong here and nowhere else, so a change
    on one side cannot silently drag the other along.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HD2SourceModel\HD2SourceModel.csproj" />
    <ProjectReference Include="..\HD2ModAdaptation\HD2ModAdaptation.csproj" />
  </ItemGroup>

  <!--
    HD2 的姿态参考表。重定向需要三张表（T-pose basis / initial basis / 轴对称 delta），
    它们描述的是**游戏自己的骨架**，不是任何第三方模型的属性，所以随本工程内置，
    转换流程因此不依赖任何外置文件。
    来源：HD2-BatchTool `assets/body_pose_profile.json`（`"source": "bundled_hd2_reference_profile"`）。
    sha256 = 0E6CD5CC2B9BED1BF39622F02AE733003E09725592457BA93BD2D512E7678F53
    The HD2 pose reference tables.  They describe the game's own skeleton rather than any
    third-party model's property, so they ship inside this project and the conversion needs
    no external file.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Retarget\body_pose_profile.json" />
  </ItemGroup>

  <!--
    HD2 的材质模板（10 份 .material，二进制 Stingray 资源，合计约 7 KB）。
    它们是**HD2 自己的材质定义**，不是第三方模型的属性，因此和内嵌的姿态参考表一样
    随本工程内置：转换流程不再依赖 HD2SDK 的安装目录。
    目录查找仍然优先（开发期改模板不必重编），找不到才用内嵌副本。
    The ten HD2 .material templates (~7 KB total) ship inside this assembly for the same
    reason as the pose profile: they describe HD2's own materials, not the third-party model.
    Disk lookup still wins so a developer can tweak a template without rebuilding.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\tools\ref\HD2SDK-CommunityEdition\materials\*.material">
      <LogicalName>HD2MaterialTemplates.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
